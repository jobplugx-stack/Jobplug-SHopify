const founderChapters=[{"focus": "HIGH SCHOOL · EARN AND LEISURE", "body": "The story started in high school in Wisconsin. The Earn and Leisure program was part of those early experiences. This is where the first ideas about work and opportunity began to take shape.", "highlights": ["The early spark", "Learning what was possible"]}, {"focus": "ST. MARY’S UNIVERSITY", "body": "St. Mary’s University helped open the door to my first internship. College in San Antonio became a turning point. That support showed me the difference one connection can make.", "highlights": ["College in San Antonio", "My first internship"]}, {"focus": "SAMSUNG AUSTIN SEMICONDUCTOR", "body": "My chapter with Samsung Austin Semiconductor became a chance to give back. I started connecting friends to opportunities and sharing what I was learning. The next door did not have to open for just one person.", "highlights": ["Giving back", "Connecting friends"]}, {"focus": "THE PUBLIC LAUNCH OF JOBPLUG", "body": "In Houston we connected with friends and built a brotherhood. That community became the foundation of JobPlug. We launched publicly and took the idea into spaces like AfroTech to keep building connections.", "highlights": ["Community into a company", "AfroTech connections"]}, {"focus": "BAE SYSTEMS", "body": "Denver brought a new chapter connected to BAE Systems. We kept building relationships and expanding the world around JobPlug. Each connection became part of the story we were taking forward.", "highlights": ["Building relationships", "Expanding our network"]}, {"focus": "BRANCHING OUT", "body": "New York was about pushing JobPlug further. We brought the vision into new conversations and kept expanding its reach. The mission stayed the same: connect people with their next opportunity.", "highlights": ["A bigger reach", "The same mission"]}, {"focus": "TEXAS ROOTS · ATLANTA TODAY", "body": "Today we are based in Atlanta with a presence in both Texas and Atlanta. Our roots remain in Texas. Our work reaches clients across the United States. The journey keeps growing with every person we help move forward.", "highlights": ["Texas + Atlanta", "Serving clients across the US"]}];
