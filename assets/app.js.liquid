function preferenceControl(){return `<fieldset class="work-preference"><legend>How do you want to work?</legend><div><button type="button" data-work-mode="remote" aria-pressed="${state.workMode==='remote'}" class="${state.workMode==='remote'?'selected':''}">Remote <small>US-based roles</small></button><button type="button" data-work-mode="local" aria-pressed="${state.workMode==='local'}" class="${state.workMode==='local'?'selected':''}">In-person or hybrid <small>In the USA</small></button></div></fieldset>`;}
