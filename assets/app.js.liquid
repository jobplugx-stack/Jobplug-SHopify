];
function termsBrief(){return `<section class="terms-brief" aria-label="Your service in four key points"><div class="brief-stage">${briefSteps.map((step,i)=>`<article class="brief-slide" data-brief-slide="${i}" ${i?'hidden':''}><span class="eyebrow">THE KEY POINTS / 0${i+1} OF 04</span><div class="brief-metric">${step.metric}</div><h2 tabindex="-1">${step.title}</h2><p class="brief-lead">${step.lead}</p><p class="brief-detail">${step.detail}</p><a href="#${step.link}">${step.label} ↗</a></article>`).join('')}<div class="brief-avatar" aria-hidden="true">${avatar()}<span>Your next step.<br>Made clear.</span></div></div><div class="brief-controls"><div class="brief-dots" aria-label="Choose a key point">${['Payment','Service days','Interviews','Your part'].map((name,i)=>`<button data-brief-go="${i}" ${i===0?'aria-current="step"':''}>0${i+1}<span>${name}</span></button>`).join('')}</div><button class="btn" id="brief-next">Next key point →</button></div><p class="brief-disclosure">A quick guide to the essentials. This does not replace the full agreement or accept terms on your behalf.</p></section>`;}
function termsHub(){const topics=[{id:'terms-payment',number:'01',title:'Payments & plans',intro:'Two ways to pay. One clear total.',questions:[['What does each plan cost?','Job Search is $299.99 paid in full. Job Search with split payments is $99.99 initially plus $300 on the 25th counted service Business Day. Job Search with split payments totals $399.99. Both include the same package service. Interview Prep is $150 separately. Job Search plus one Interview Prep session is also offered as a $399.99 paid-in-full bundle. The bundle discount does not apply to split payments.'],['When will the second payment happen?','Job Search with split payments uses the 25th counted service Business Day. A reminder is sent 2 counted service Business Days before the charge. Keep a valid card on file. Review and authorize the payment schedule at checkout.'],['What if a payment is missed?','Service may be placed on hold. The full agreement explains service cancellation and access consequences. Contact JobPlug before disputing a charge.']]},{id:'terms-days',number:'02',title:'Your service window',intro:'Understand exactly which days count.',questions:[['When does my 30-day count start?','On the first day JobPlug submits applications for you. Only qualifying application days count. Both payment options include 30 counted service Business Days.'],['What happens around holidays?','Weekends and holidays are off. JobPlug applies on the Business Day before and after a holiday but those buffer days are excluded from the service count.'],['What happens after I purchase?','Complete Career Profile Setup. After intake you receive a profile-received email. Setup follows within 24 hours. Your welcome email includes a personal guide and dedicated job-search inbox. Reports arrive every Friday.']]},{id:'terms-interviews',number:'03',title:'Interviews & refunds',intro:'Your choices. Our commitment.',questions:[['Can I decline an Interview?','Yes. You may accept or reschedule or decline freely. A qualifying Interview secured by JobPlug still counts toward the commitment even if you decline. Once a qualifying Interview is secured the no-interview refund does not apply.'],['What if no Interview is secured?','You may request a full refund of Interview Package payments within 7 days after the service window closes. Email support@jobplug.co. JobPlug checks the qualifying Interview record and your responsibilities under the agreement.'],['Is a job offer guaranteed?','No. Employers make hiring decisions. The commitment concerns a qualifying Interview. Assessments and tests are tracked separately and do not count as Interviews.'],['What about Interview Prep refunds?','The separate $150 live 45-minute Interview Prep product is non-refundable once accessed.']]},{id:'terms-account',number:'04',title:'Your inbox & responsibilities',intro:'Keep the connection moving.',questions:[['What should I check each day?','Keep inbox notifications enabled and check starred messages. Reply to Interview requests within 24 to 48 hours. Text JobPlug the company and role within 24 hours of recruiter contact.'],['Can I keep my job-search inbox?','You keep the login after service only if the package is paid in full. Clients who are not paid in full lose access after service. Do not change the password or delete emails during the service window.'],['Can I change career direction?','One direction switch is included. Further switches cost $150 each. The counted service window continues during a switch.'],['How do I get help?','Email support@jobplug.co or text 832-975-3601. Google sign-in code help is available 7 AM to 2 PM Eastern Time. Text replies are available Monday through Friday with limited weekend coverage.']]}];return `<section class="content-page terms-hub"><div class="hub-guide" aria-hidden="true">${avatar()}</div><div class="agreement-access"><span>Clear information before you commit.</span><a href="#agreement">Read the full 25-section agreement ↗</a></div><div class="hub-heading"><span class="eyebrow">The JobPlug terms hub</span><h1 class="page-title">Know the plan.<br><em>Move with confidence.</em></h1><p>Four key points. One clear next step.</p></div>${termsBrief()}<h2 class="hub-detail-title">Go a little deeper.</h2><div class="terms-topic-grid">${topics.map(t=>`<button class="terms-topic" data-topic="${t.id}"><span>${t.number}</span><h2>${t.title}</h2><p>${t.intro}</p><b aria-hidden="true">↗</b></button>`).join('')}</div><div class="hub-answers">${topics.map(t=>`<details class="topic-accordion" id="${t.id}"><summary><span>${t.number}</span>${t.title}<i aria-hidden="true">+</i></summary><div class="topic-answers">${t.questions.map(([q,a])=>`<article><h3>${q}</h3><p>${a}</p></article>`).join('')}<a href="#agreement">Read the full agreement ↗</a></div></details>`).join('')}</div><div class="hub-bottom"><div><h2>Every detail. In one place.</h2><p>This hub summarizes the service. The full agreement contains all 25 sections.</p></div><a class="btn" href="#agreement">Open full agreement ↗</a></div></section>`}

function agreementPage(){return `<section class="content-page terms-page"><div class="terms-header"><span class="eyebrow">JobPlug LLC / Houston, Texas</span><h1 class="page-title">Clear terms.<br>Confident next steps.</h1><div class="terms-version">PROPOSED NEW-PURCHASE VERSION · November 5 2026</div><p>Based on the October 20 2026 master agreement and the current service facts. Updated November 5 2026. Intended for new purchases once connected to checkout. Viewing this page does not accept an agreement or process payment.</p><a class="terms-source" href="https://drive.google.com/file/d/1yBJUfDiyeWsjY2whJQMZtI3Hdgi-qD7d/view?usp=sharing" target="_blank" rel="noopener">Original master · October 20 2026 ↗</a><p class="source-caution">Historical source. Contains superseded pricing and service-day details.</p></div><div class="terms-short"><span class="eyebrow">The short version</span><div class="terms-summary-grid"><article><b>30 counted service Business Days</b><p>Starts when we first apply. Only days we submit applications count. Weekends and holidays are excluded. We apply before and after holidays but the adjacent Business Days are excluded from your count.</p></article><article><b>One service. Two payment choices.</b><p>Job Search: $299.99 paid in full. Job Search with split payments: $99.99 initially plus $300 automatically on the 25th counted service Business Day. Total $399.99.</p></article><article><b>An interview commitment</b><p>At least one qualifying Interview within your service window. No job-offer guarantee. The full refund conditions appear in Section 6, including how a declined qualifying Interview affects eligibility.</p></article><article><b>Purchase, intake, then setup</b><p>US-only, self-service enrollment. Complete intake after payment. Setup follows within 24 hours, with a welcome guide and job-search inbox.</p></article></div></div><div class="terms-layout"><aside class="terms-index" aria-label="Terms section index"><h2>Inside these terms</h2>${termsSections.map(t=>`<button data-term="${t.n}"><span>${String(t.n).padStart(2,'0')}</span>${t.title}</button>`).join('')}</aside><div class="terms-full">${termsSections.map(t=>`<section class="terms-clause " id="terms-clause-${t.n}" tabindex="-1"><h2><span>${String(t.n).padStart(2,'0')}</span>${t.title}</h2>${t.paragraphs.map(p=>`<p>${p}</p>`).join('')}</section>`).join('')}<div class="terms-contact"><h2>Questions about your service?</h2><p><a href="mailto:support@jobplug.co">support@jobplug.co</a> · <a href="tel:+18329753601">832-975-3601</a></p><p>Backup: <a href="mailto:jobplugx@gmail.com">jobplugx@gmail.com</a></p><a href="/#pricing" class="btn">Back to plans →</a></div></div></div></section>`}
function policy(type){if(type==='terms')return termsHub();const title=type==='privacy'?'Your privacy':'Refund & cancellation';const content=type==='privacy'?`<p>The current JobPlug Privacy Policy describes information collection, use, sharing, and privacy requests. The full published store policy appears below. It is dated October 30 2026.</p><a class="btn" href="https://checkout.shopify.com/64449642631/policies/30986895495.html?locale=en-US" target="_blank" rel="noopener">Read current privacy policy ↗</a><h2>About this prototype</h2><p>This preview does not request your résumé or payment information. The optional email-draft form asks for your email to prepare a message locally. It does not send or store that email. You must review and send the message in your email app. If sent your email and selected preferences are shared with JobPlug at jobplux@gmail.com. Marketing updates are optional and are not selected by default. Journey preferences are saved in session storage for this browser tab when available. They survive reloads. Use Clear my selections in the journey to remove them. They are not sent to JobPlug. No email address is required to save progress on this device. If you choose Save on this device the preferences are kept in this browser’s local storage until you clear them. Clear my selections removes both the tab preferences and the saved copy. The hosting provider may process ordinary access logs.</p><h2>Published store privacy policy</h2><p>This is the existing Shopify store policy. It describes the store and its services. The preview-specific information above describes this new website.</p><div class="published-policy">${window.JOBPLUG_PUBLISHED_PRIVACY||'Read the current policy using the link above.'}</div>`:`<p>JobPlug commits to securing at least one qualifying Interview within 30 counted service Business Days. If none is secured, you may request a full refund of the Interview Package payments within 7 days after the service window closes.</p><p>Requests go to <a href="mailto:support@jobplug.co">support@jobplug.co</a>. JobPlug reviews whether an Interview was secured and whether client responsibilities were met. Approved refunds go to the original payment method and can arrive in as little as 24 hours.</p><div class="notice"><strong>You may freely decline an Interview.</strong> A qualifying Interview secured by JobPlug still counts toward the interview commitment. Once one is secured the no-interview refund does not apply even if you decline it.</div><p>Other cancellation, attendance, and payment provisions remain in the full agreement. Read Sections 6, 8, 9, 12, and 13 before relying on a policy summary.</p><a class="btn" href="#agreement">Read all 25 terms →</a><h2>Interview Prep</h2><p>The $150 live 45-minute Interview Prep add-on is non-refundable once accessed.</p>`;return `<section class="content-page"><div class="policy-content"><span class="eyebrow">Clear information, before you commit</span><h1 class="page-title">${title}</h1><div class="notice">${type==='privacy'?'Website preview · Store policy dated October 30 2026.':'Proposed new-purchase version · November 5 2026.'}</div>${content}<p><a href="mailto:support@jobplug.co">support@jobplug.co ↗</a> · <a href="tel:+18329753601">832-975-3601</a></p><a class="link" style="color:var(--ink)" href="/#pricing">← Back to plans</a></div></section>`}

// Store preferences only. Payment status and personal information are never stored here.
function saveJourney(){try{window.sessionStorage.setItem('jobplug-journey-v1',JSON.stringify({location:state.location,answers:state.answers,step:state.step,plan:state.plan,workMode:state.workMode}));}catch{/* The journey still works when storage is blocked. */}}
try{const saved=JSON.parse(window.sessionStorage.getItem('jobplug-journey-v1')||window.localStorage.getItem('jobplug-saved-journey-v1'));if(saved&&typeof saved==='object'){state.location=states.includes(saved.location)?saved.location:'';state.workMode=saved.workMode==='local'?'local':'remote';state.plan=saved.plan==='Secure Plus'?'Secure Plus':'Secure';state.step=Number.isInteger(saved.step)&&saved.step>=0&&saved.step<3?saved.step:0;state.answers=Array.isArray(saved.answers)?saved.answers.slice(0,3).map((a,i)=>Number.isInteger(a)&&a>=0&&a<questions[i].choices.length?a:undefined):[];}}catch{/* A missing or corrupt saved journey starts fresh. */}
function render(keepScroll=false){window.JobPlugHow?.unmount();const pathRoutes={'/':'home','/plans/':'plans','/interview-prep/':'prep','/how-it-works/':'how','/our-story/':'story','/terms/':'terms','/renew/':'renew','/help/':'help','/agreement/':'agreement','/privacy/':'privacy','/refund/':'refund'};const currentPath=location.pathname.replace(/\/?$/,'/');const hashRoute=location.hash.slice(1);const route=hashRoute==='main'?(state.route||pathRoutes[currentPath]||'home'):(hashRoute||pathRoutes[currentPath]||'home');state.route=route;const views={home,journey,summary:journeySummary,connect:connectPlan,plans,story,how,help,prep,review,complete,renew,agreement:agreementPage,terms:()=>policy('terms'),privacy:()=>policy('privacy'),refund:()=>policy('refund')};$('#main').innerHTML=(views[route]||home)();$('#main').classList.remove('fade-in');void $('#main').offsetWidth;$('#main').classList.add('fade-in');document.title=`${({home:'Done-for-you career support',story:'Our story',plans:'Job Search & payment options',journey:'Your career journey',summary:'Your saved search preferences',connect:'Stay connected',help:'FAQ & support',how:'How JobPlug works',prep:'Live Interview Prep · $150',terms:'Terms hub',agreement:'Full service agreement',renew:'Renew your journey',privacy:'Privacy',refund:'Refund & cancellation',review:'Review your plan'})[route]||'Your next connection'}  ·  JobPlug`;document.querySelectorAll('nav a').forEach(a=>a.classList.toggle('active',a.hash===`#${route}`));$('nav').classList.remove('open');$('.menu').setAttribute('aria-expanded','false');if(!keepScroll)window.scrollTo(0,0);bind();}
function bind(){$('#lead-form')?.addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget;if(!form.reportValidity())return;const email=$('#lead-email').value.trim();const lines=['Hi JobPlug.','Please follow up about my job search.','Reply email: '+email];if(state.location){lines.push('State: '+state.location,'Work preference: '+(state.workMode==='remote'?'Remote US-based roles':'In-person or hybrid'));questions.forEach((q,i)=>lines.push(q.title+' '+(q.choices[state.answers[i]]?.[1]||'Not selected')));}lines.push('Marketing updates requested: '+($('#lead-marketing').checked?'Yes':'No'));$('#lead-draft-link').href='mailto:jobplux@gmail.com?subject='+encodeURIComponent('My JobPlug search plan')+'&body='+encodeURIComponent(lines.join('\n'));$('#lead-draft').hidden=false;$('#lead-draft-link').focus();});$('#save-journey')?.addEventListener('click',()=>{const message=$('#summary-status');try{window.localStorage.setItem('jobplug-saved-journey-v1',JSON.stringify({location:state.location,workMode:state.workMode,step:state.step,answers:state.answers}));message.textContent='Saved on this device. Use Resume my saved journey on the homepage when you return.';}catch{message.textContent='This browser could not save your preferences. Keep this tab open or copy your summary before leaving.';}});$('#resume-journey')?.addEventListener('click',()=>{applySavedJourney(savedJourney());location.hash='summary';});document.querySelectorAll('[name="payment-choice"]').forEach(input=>input.addEventListener('change',()=>{state.plan=input.value;const split=state.plan==='Secure Plus';$('#single-due').textContent=split?'$99.99':'$299.99';$('#single-schedule').hidden=!split;$('#single-continue').dataset.plan=state.plan;}));let briefIndex=0;const showBrief=(index,moveFocus=false)=>{briefIndex=index;document.querySelectorAll('[data-brief-slide]').forEach((slide,i)=>slide.hidden=i!==index);document.querySelectorAll('[data-brief-go]').forEach((button,i)=>{if(i===index)button.setAttribute('aria-current','step');else button.removeAttribute('aria-current');});const next=$('#brief-next');if(next)next.textContent=index===3?'Back to the first point ↺':'Next key point →';$('#announcement').textContent=`Key point ${index+1} of 4. ${briefSteps[index].title}`;if(moveFocus){document.querySelector(`[data-brief-slide="${index}"] h2`)?.focus({preventScroll:true});document.querySelector(".terms-brief")?.scrollIntoView({behavior:state.motion?"auto":"smooth",block:"start"});}};document.querySelectorAll('[data-brief-go]').forEach(button=>button.addEventListener('click',()=>showBrief(Number(button.dataset.briefGo),true)));$('#brief-next')?.addEventListener('click',()=>showBrief((briefIndex+1)%4,true));$('#clear-journey')?.addEventListener('click',()=>{state.location='';state.answers=[];state.step=0;state.plan='Secure';state.workMode='remote';try{window.sessionStorage.removeItem('jobplug-journey-v1');window.localStorage.removeItem('jobplug-saved-journey-v1');}catch{}render();$('#announcement').textContent='Your selections have been cleared.';$('#state-select')?.focus();});if(state.route==='how')window.JobPlugHow?.mount();document.querySelectorAll('[data-open-plug]').forEach(b=>b.addEventListener('click',()=>window.JobPlugQuick?.open(b)));document.querySelectorAll('[data-work-mode]').forEach(b=>b.addEventListener('click',()=>{state.workMode=b.dataset.workMode;document.querySelectorAll('[data-work-mode]').forEach(x=>{x.classList.toggle('selected',x===b);x.setAttribute('aria-pressed',String(x===b));});updateLocationScene();}));$('#change-preference')?.addEventListener('click',()=>{state.location='';render();$('[data-work-mode]')?.focus();});document.querySelectorAll('[data-topic]').forEach(b=>b.addEventListener('click',()=>{const panel=document.getElementById(b.dataset.topic);panel.open=true;panel.scrollIntoView({behavior:state.motion?'auto':'smooth',block:'start'});panel.querySelector('summary').focus({preventScroll:true});}));document.querySelectorAll('[data-term]').forEach(b=>b.addEventListener('click',()=>{const target=document.getElementById('terms-clause-'+b.dataset.term);target.scrollIntoView({behavior:state.motion?'auto':'smooth',block:'start'});target.focus({preventScroll:true});}));const form=$('#start-form');if(form)form.addEventListener('submit',e=>{e.preventDefault();const select=$('#state-select');if(!select.value){select.setCustomValidity('Choose a state to continue.');select.reportValidity();return;}select.setCustomValidity('');state.location=select.value;state.step=0;if(location.hash==='#journey'){render();$('#main').focus({preventScroll:true});}else location.hash='journey';});$('#state-select')?.addEventListener('change',e=>{e.target.setCustomValidity('');state.location=e.target.value;updateLocationScene();});$('#change-state')?.addEventListener('click',()=>{state.location='';render();$('#state-select')?.focus();});document.querySelectorAll('[data-answer]').forEach(b=>b.addEventListener('click',()=>{state.answers[state.step]=+b.dataset.answer;document.querySelectorAll('[data-answer]').forEach(x=>{x.classList.toggle('selected',x===b);x.setAttribute('aria-pressed',String(x===b));});document.querySelectorAll('[data-answer] i').forEach(icon=>icon.textContent=icon.parentElement===b?'✓':'↗');$('#next-question').disabled=false;}));$('#next-question')?.addEventListener('click',()=>{if(state.answers[state.step]===undefined)return;if(state.step<2){state.step++;render(true);$('.question h1').setAttribute('tabindex','-1');$('.question h1').focus();}else location.hash='summary';});$('#back-question')?.addEventListener('click',()=>{if(state.step>0)state.step--;else state.location='';render();const focusTarget=$('#state-select')||$('#main');focusTarget.focus({preventScroll:true});});document.querySelectorAll('[data-plan]').forEach(b=>b.addEventListener('click',()=>{state.plan=b.dataset.plan;location.hash='review';}));document.querySelectorAll('[data-city]').forEach(b=>b.addEventListener('click',()=>setCity(+b.dataset.city)));$('#next-city')?.addEventListener('click',()=>setCity(Math.min(cities.length-1,state.city+1)));$('#prev-city')?.addEventListener('click',()=>setCity(Math.max(0,state.city-1)));}
function setCity(i){state.city=Math.max(0,Math.min(cities.length-1,i));render();$('#announcement').textContent=`Chapter ${i+1}: ${cities[i][0]}`;document.querySelector(`[data-city="${i}"]`).focus({preventScroll:true});}
window.addEventListener('jobplug:choose',event=>{if(!['Secure','Secure Plus'].includes(event.detail))return;state.plan=event.detail;if(location.hash==='#review'){render();$('#main').focus({preventScroll:true});}else location.hash='review';});
document.addEventListener('click',()=>setTimeout(saveJourney,0));document.addEventListener('change',()=>setTimeout(saveJourney,0));
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('header nav').classList.contains('open')){$('header nav').classList.remove('open');$('.menu').setAttribute('aria-expanded','false');$('.menu').focus();}});
$('.menu').addEventListener('click',()=>{const open=$('nav').classList.toggle('open');$('.menu').setAttribute('aria-expanded',String(open));});document.querySelectorAll('.motion').forEach(button=>button.addEventListener('click',()=>{state.motion=!state.motion;document.body.classList.toggle('no-motion',state.motion);document.querySelectorAll('.motion').forEach(b=>{b.textContent=state.motion?'Resume motion':'Pause motion';b.setAttribute('aria-pressed',String(state.motion));});}));window.addEventListener('hashchange',()=>{if(location.hash==='#main'){$('#main').focus({preventScroll:true});return;}render();$('#main').focus({preventScroll:true});});render();

if(state.motion){document.body.classList.add('no-motion');document.querySelectorAll('.motion').forEach(b=>{b.textContent='Reduced motion';b.disabled=true;b.setAttribute('aria-pressed','true');});}
