function locationMap(){const project=([lat,lon])=>[40+(lon+125)/59*520,20+(50-lat)/26*235];const coast=[[48.5,-124.7],[49,-123],[49,-117],[49,-110],[49,-102],[49,-95],[48,-93],[48.5,-89],[46.8,-85],[45.7,-84],[43.5,-82.5],[42,-83],[41.7,-81],[42.5,-79],[43.5,-76],[45,-74.7],[45,-71.5],[47.3,-69.2],[47,-67.8],[45,-67],[44.5,-67.8],[43,-70.7],[42.3,-70.5],[41.5,-71],[41,-73],[40.5,-74],[39,-74.8],[37,-76],[35,-75.5],[34,-77.8],[32,-81],[30,-81.4],[27,-80.4],[25.2,-80.5],[24.7,-81.7],[27,-82.7],[29,-83],[30.3,-85],[30,-89],[29,-90],[29.5,-93.5],[28,-96.5],[26,-97.2],[26,-99],[29,-103],[29.8,-104],[31.8,-106.5],[31.3,-111],[32.5,-114.7],[32.5,-117],[34.5,-120.5],[37,-122],[40,-124],[42,-124.4],[45,-124],[48.5,-124.7]];const shape=coast.map((p,i)=>`${i?'L':'M'}${project(p).join(',')}`).join('')+'Z';const points=Object.entries(stateCenters).map(([name,p])=>{let [x,y]=name==='Alaska'?[88,285]:name==='Hawaii'?[181,290]:project(p);const active=name===state.location;return `<g class="state-pin ${active?'active':''}"><title>${name}</title>${active?`<circle class="state-pulse" cx="${x}" cy="${y}" r="12"/>`:''}<circle cx="${x}" cy="${y}" r="${active?5:2.1}"/></g>`}).join('');const label=state.location||'Choose your home state';return `<div class="location-map"><div class="map-topline"><span>YOUR WORLD OF OPPORTUNITY</span><b>${state.workMode==='remote'?'Remote · USA':'In-person / hybrid · USA'}</b></div><svg viewBox="0 0 600 330" role="img" aria-label="US location preference map. ${escapeHtml(label)}. ${state.workMode==='remote'?'Remote US-based roles':'In-person or hybrid roles'}. Not live job openings."><path class="us-land" d="${shape}"/><path class="inset-land" d="M51 273l20-18 24 6 12 12 15 4-9 13-22-5-14 12-19-8-16 5 10-12z M161 282l7 2 3 5-5 2z M174 288l9 1 3 5-7 1z M190 294l9-3 7 6-5 7-10-3z"/><path class="map-connection" d="M85 155Q250 20 475 110 M85 155Q310 270 475 110"/><text x="67" y="317">ALASKA</text><text x="163" y="317">HAWAII</text>${points}</svg><div class="map