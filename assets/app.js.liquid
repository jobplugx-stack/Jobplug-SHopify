const $=s=>document.querySelector(s);
const escapeHtml=value=>String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function configuredUrl(key){const allowed=['secureUrl','securePlusUrl','interviewPrepUrl','calendlyUrl','intakeUrl','renewalUrl'];if(!allowed.includes(key))return '';const raw=window.JOBPLUG_CONFIG?.[key];if(typeof raw!=='string'||!raw.trim())return '';try{const url=new URL(raw.trim());return url.protocol==='https:'&&url.hostname&&!url.username&&!url.password?url.href:'';}catch{return '';}}
function handoff(key,label,missing='Checkout is being connected'){const url=configuredUrl(key);const payment=['secureUrl','securePlusUrl','interviewPrepUrl','renewalUrl'].includes(key);const ready=url&&(!payment||window.JOBPLUG_CONFIG?.mode==='live');return ready?`<a class="btn" href="${escapeHtml(url)}">${label} <span aria-hidden="true">↗</span></a><p class="handoff-status">Continue on the secure provider page. Return here if you need help.</p>`:`<div class="handoff-notice" role="note"><b>${payment?'Preview only. Checkout is not open.':'This service link is not connected yet.'}</b><p>${payment?'You can explore the plans here. No payment is taken on this preview.':'Already purchased? Contact support for your next step.'}</p><a href="mailto:support@jobplug.co">Get help from JobPlug ↗</a></div>`;}
function afterPurchase(){return `<section class="purchase-timeline" aria-label="What happens after payment"><span class="eyebrow">NO GUESSWORK AFTER CHECKOUT</span><h2>Pay. Share your story.<br>We take it from there.</h2><ol><li><b>01 / Complete your profile</b><p>After purchase fill out Career Profile Setup. Tell us about your experience and goals.</p></li><li><b>02 / Get connected</b><p>Receive a profile-received email. Setup follows within 24 hours. Your welcome email brings your guide and job-search inbox.</p></li><li><b>03 / Follow your progress</b><p>We build your résumé and apply. Check Starred for important messages. Your report arrives every Friday.</p></li></ol><p class="timeline-foot">Your 30 counted service Business Days begin with your first eligible application day. <a href="#terms">See how the days count ↗</a></p></section>`;}
function interviewCommitment(){return `<aside class="interview-commitment"><span class="eyebrow">OUR INTERVIEW COMMITMENT</span><h2>A real next conversation.</h2><p>At least one qualifying interview within your 30 counted service Business Days. If none is secured you may request a full refund of your package payments within 7 days after the window closes. Eligibility depends on meeting the agreement’s client responsibilities.</p><p>A qualifying interview counts even if you decline it. This is not a job-offer guarantee.</p><a href="#refund">Read the refund conditions ↗</a> <a href="#agreement">Read the full agreement ↗</a></aside>`;}

