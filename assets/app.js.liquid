const statePicker=()=>`<div class="state-box"><label for="state-select">WHERE ARE YOU STARTING?</label><select id="state-select"><option value="">Choose your state</option>${states.map(s=>`<option ${state.location===s?'selected':''}>${s}</option>`).join('')}</select></div>`;
function opportunityWall(){const brands=[['SpaceX','spacex','EXPLORING WHAT’S NEXT'],['Apple','apple','DESIGNING WHAT’S NEXT'],['Google','google','CONNECTING THE WORLD'],['Amazon','amazon','BUILDING AT SCALE'],['Tesla','tesla','MOVING THE WORLD'],['Samsung','samsung','ENGINEERING POSSIBILITY']];return `<section class="opportunity-wall logo-showcase" aria-label="Client interview destinations"><div class="logo-orbit" aria-hidden="true"></div><span class="eyebrow">INTERVIEW DESTINATIONS</span><h2>Real conversations.<br><em>New possibilities.</em></h2><p>Big names. Real next steps.<br>Companies where JobPlug clients have interviewed.</p><div class="brand-gallery">${brands.map(([name,slug,caption],i)=>`<article class="brand-stage brand-${slug}" style="--brand-delay:${i*-.9}s"><div class="brand-light" aria-hidden="true"></div><span class="brand-index" aria-hidden="true">0${i+1}</span><span class="brand-name">${name}</span></article>`).join('')}</div><div class="brand-more"><span>MORE DOORS. MORE POSSIBILITY.</span><span class="brand-more-name">AMD</span><span class="brand-more-name">TikTok</span></div><small>Past interviews do not imply employer partnership or guarantee future results.<br>Company names belong to their respective owners.</small><a class="btn" href="/#pricing">Find my way in →</a></section>`;}

function home(){return homeBase()+opportunityWall();}
function story(){return storyBase()+(state.city===cities.length-1?opportunityWall():'');}
function homeBase(){return `<section class="hero home">${scene(0,true)}<div class="world-orbits" aria-hidden="true"><div class="world-card"><img src="{{ 'work-care.jpg' | asset_url }}" alt=""><b>Care & community</b></div><div class="world-card"><img src="{{ 'work-office.jpg' | asset_url }}" alt=""><b>Office & digital</b></div><div class="world-card"><img src="{{ 'work-trades.jpg' | asset_url }}" alt=""><b>Hands-on careers</b></div><div class="world-card"><img src="{{ 'work-hospitality.jpg' | asset_url }}" alt=""><b>Hospitality & service</b></div></div><div class="hero-content"><div class="mobile-hero-guide" aria-hidden="true">${avatar()}</div><span class="eyebrow">Real people. Real direction.</span><h1>Your world<br>of <em>opportunity.</em></h1><p class="intro">We find roles. We submit applications. You stay ready for your next interview.</p>${preferenceControl()}<form class="start-form" id="start-form">${statePicker()}<button class="btn">Start my journey <span>↗</span></button></form><p class="helper">US-only · Self-service · Purchase then complete intake.</p><div class="location-caption" aria-live="polite">${locationCaption()}</div><button class="quick-inline" type="button" data-open-plug><span>I know what I want</span><b>Straight to the Plug →</b></button>${savedJourney()?'<button class="text-btn resume-journey" id="resume-journey">Resume my saved journey ↗</button>':''}<div class="hero-bottom"><p><b>01 / TELL US YOUR GOALS</b>Start with where you want to go.</p><p><b>02 / GET REAL SUPPORT</b>Let’s take the next steps together.</p></div></div></section><section class="section"><div class="split"><div><span class="eyebrow">A human approach to your next move</span><h2>You don’t have to<br>figure it out alone.</h2></div><div><p>JobPlug helps with the work behind your job search · from finding roles and strengthening your résumé to preparing for interviews.</p><a class="btn" href="/#how">Watch how JobPlug works <span>→</span></a></div></div><div class="steps"><article class="step"><div class="num">01 / DIRECTION</div><h3>A plan with you in mind.</h3><p>Share your experience and goals so your search starts in the right direction.</p></article><article class="step"><div class="num">02 / PREPARATION</div><h3>Put your strengths forward.</h3><p>Résumé, LinkedIn, and interview support to help you tell your story clearly.</p></article><article class="step"><div class="num">03 / CONNECTION</div><h3>Keep moving toward the door.</h3><p>Targeted applications submitted on your behalf, with a team supporting the process.</p></article></div></section><section class="section dark"><div class="split"><div><span class="eyebrow">The story behind the connection</span><h2>Every city<br>added something.</h2></div><div><p>Follow the route from Wisconsin to Atlanta. Discover the idea that became JobPlug.</p><a class="btn secondary" href="/#story">Follow the story <span>↗</span></a></div></div></section>`}
const questions=[{title:'What kind of work interests you?',choices:[['♡','Working with people'],['⚒','Hands-on work'],['⌘','Office & digital'],['↗','I’m exploring']]},{title:'Where are you in your career?',choices:[['✧','Starting out'],['↗','Making a change'],['↺','Returning to work']]},{title:'When are you hoping to start?',choices:[['→','As soon as possible'],['◷','Within a month'],['◎','Exploring options']]}];
function journey(){if(!state.location)return `<section class="hero journey">${scene(0,true)}<div class="hero-content"><span class="eyebrow">Your journey / Step 1</span><h1>Every journey<br>starts <em>somewhere.</em></h1><p class="intro">Choose your state. Let’s take it from there.</p>${preferenceControl()}<form class="start-form" id="start-form">${statePicker()}<button class="btn">Continue →</button></form><div class="location-caption" aria-live="polite">${locationCaption()}</div></div><div class="avatar-wrap">${avatar()}</div></section>`;const q=questions[state.step];return `<section class="hero journey quiz-story">${scene()}<div class="quiz-deck"><div class="quiz-progress" role="progressbar" aria-label="Your journey" aria-valuemin="1" aria-valuemax="3" aria-valuenow="${state.step+1}" aria-valuetext="Question ${state.step+1} of 3">${questions.map((_,i)=>`<span class="${i<=state.step?'filled':''}"></span>`).join('')}</div><div class="quiz-top"><span>YOUR NEXT CHAPTER</span><span>0${state.step+1} / 03</span></div><div class="quiz-guide"><div aria-hidden="true">${avatar()}</div><p>${['Let’s find your direction.','Every starting point counts.','Your pace. Your next step.'][state.step]}</p></div><div class="question"><span class="eyebrow">${escapeHtml(state.location)} · ${state.workMode==='remote'?'Remote':'In-person / hybrid'}</span><h1>${q.title}</h1><p class="quiz-hint">Tap what feels right for you.</p><div class="choices" role="group" aria-label="${q.title}">${q.choices.map(([icon,text],i)=>`<button class="choice ${state.answers[state.step]===i?'selected':''}" aria-pressed="${state.answers[state.step]===i}" data-answer="${i}"><span aria-hidden="true">${icon}</span><b>${text}</b><i aria-hidden="true">${state.answers[state.step]===i?'✓':'↗'}</i></button>`).join('')}</div><div class="question-actions"><button class="text-btn" id="back-question">← Back</button><button class="btn" id="next-question" ${state.answers[state.step]===undefined?'disabled':''}>${state.step===2?'See my next steps':'Continue'} →</button></div></div><div class="quiz-foot"><button class="text-btn" id="change-state">Change state</button><button class="text-btn" id="change-preference">Change work preference</button><button class="text-btn" id="clear-journey">Start over</button></div><p class="quiz-privacy">Your answers stay in this browser. You choose whether to share them at the end.</p></div></section>`}

const includes='<ul><li>Applications submitted on your behalf</li><li>Résumé & LinkedIn optimization</li><li>Dedicated job-search inbox</li><li>Weekly Friday progress reports</li></ul>';
function savedJourney(){try{const saved=JSON.parse(window.localStorage.getItem('jobplug-saved-journey-v1'));return saved&&states.includes(saved.location)?saved:null;}catch{return null;}}
function applySavedJourney(saved){if(!saved)return;state.location=states.includes(saved.location)?saved.location:'';state.workMode=saved.workMode==='local'?'local':'remote';state.step=Number.isInteger(saved.step)&&saved.step>=0&&saved.step<3?saved.step:0;state.answers=Array.isArray(saved.answers)?saved.answers.slice(0,3).map((a,i)=>Number.isInteger(a)&&a>=0&&a<questions[i].choices.length?a:undefined):[];}
function emailPlanForm(){return `<section class="email-plan"><span class="eyebrow">KEEP THE CONVERSATION GOING</span><h2>Not ready to buy?<br>Send us your next steps.</h2><p>Share your search plan with JobPlug. Purchase is optional.</p><form id="lead-form"><label for="lead-email">Your email</label><input id="lead-email" name="email" type="email" autocomplete="email" maxlength="254" required placeholder="you@example.com"><label class="lead-check"><input id="lead-share" type="checkbox" required><span>Include my email and the preferences shown here in a message to JobPlug.</span></label><label class="lead-check"><input id="lead-marketing" type="checkbox"><span>I would also like JobPlug news and offers. Optional.</span></label><button class="btn" type="submit">Prepare my email →</button></form><div id="lead-draft" class="lead-draft" hidden><p role="status">Your draft is ready. It has not been sent.</p><a class="btn" id="lead-draft-link">Open email draft ↗</a><p>Review the message then press Send in your email app. If no email app opens write to <a href="mailto:jobplux@gmail.com">jobplux@gmail.com</a>.</p></div><p class="lead-explainer">Opens your email app with a draft to <b>jobplux@gmail.com</b>. This website does not send or store your email. Automatic capture is not connected. <a href="#privacy">Privacy</a></p></section>`;}
function connectPlan(){return `<section class="content-page connect-plan"><span class="eyebrow">YOUR NEXT STEP / AT YOUR PACE</span><h1 class="page-title">Stay connected.</h1><p>${state.location?'Your message will include your current search preferences.':'Ask us about the Job Search service. You can add your goals to the email before sending.'}</p>${emailPlanForm()}<a class="link" href="/#pricing">Continue to payment options →</a></section>`;}
function journeySummary(){if(!state.location)return `<section class="content-page"><h1 class="page-title">Your next step starts here.</h1><p>Choose your preferences to build a short search summary.</p><a class="btn" href="/#journey">Start my journey →</a></section>`;return `<section class="hero journey-summary">${scene()}<div class="summary-panel"><span class="eyebrow">YOUR SEARCH / YOUR STARTING POINT</span><h1>Your next chapter.<br><em>At your pace.</em></h1><p>You have a clearer picture of what comes next. Keep your preferences for later or explore the service.</p><dl><div><dt>Where</dt><dd>${escapeHtml(state.location)}</dd></div><div><dt>Work preference</dt><dd>${state.workMode==='remote'?'Remote US-based roles':'In-person or hybrid'}</dd></div>${questions.map((q,i)=>`<div><dt>${['Your interests','Career stage','Timing'][i]}</dt><dd>${escapeHtml(q.choices[state.answers[i]]?.[1]||'Not selected')}</dd></div>`).join('')}</dl>${emailPlanForm()}<div class="summary-actions"><a class="btn" href="/#pricing">View payment options →</a><button class="btn secondary" id="save-journey">Save on this device</button></div><p class="summary-status" role="status" id="summary-status"></p><p class="summary-note">Saving keeps these preferences in this browser until you clear them. Your preferences have not been sent to JobPlug unless you send the optional email draft. Complete your full Career Profile after purchase.</p><div class="summary-links"><a href="/#journey">Edit my answers</a><button class="text-btn" id="clear-journey">Clear my selections</button></div></div></section>`;}
function plans(){const split=state.plan==='Secure Plus';return `<section class="hero cinematic-plans single-service">${scene(0,true)}<div class="plans-layout"><div class="plans-story"><span class="eyebrow">Done-for-you career support</span><h1>Your search.<br><em>Our follow-through.</em></h1><p class="intro">We find roles. We build your résumé.<br>We submit applications.</p><p class="service-window-note">30 counted service Business Days.<br>US-only. No job-offer guarantee.</p><div class="plan-guide">${avatar()}<div class="guide-caption"><span>YOUR JOBPLUG GUIDE</span><p>One service. Choose how you pay.</p></div></div><a class="link" href="#help">Read the FAQ ↗</a></div><div class="plans-choice"><article class="plan cinematic-card unified-plan"><span class="eyebrow">YOUR DONE-FOR-YOU SERVICE</span><h2>Job Search</h2><p class="unified-description">The application work handled for you. Stay ready for your next interview.</p>${includes}<fieldset class="payment-choices"><legend>Choose how you pay</legend><label><input type="radio" name="payment-choice" value="Secure" ${split?'':'checked'}><span><b>Pay in full</b><small>$299.99 today. Save $100.</small></span><strong>$299.99<span>total</span></strong></label><label><input type="radio" name="payment-choice" value="Secure Plus" ${split?'checked':''}><span><b>Split payments</b><small>$99.99 today + $300 later.</small></span><strong>$399.99<span>total</span></strong></label></fieldset><p class="payment-shared">Same service with either payment option.</p><div class="single-schedule" id="single-schedule" ${split?'':'hidden'}><b>Your split-payment schedule</b><p>$99.99 today. Your card is automatically charged $300 on the 25th counted service Business Day. A reminder is sent 2 counted service Business Days before the charge.</p></div><div class="single-due" aria-live="polite"><span>Due today</span><strong id="single-due">${split?'$99.99':'$299.99'}</strong></div><button class="btn" id="single-continue" data-plan="${split?'Secure Plus':'Secure'}">Review my payment choice →</button><p class="payment-shared">Review the terms before checkout. Payment does not guarantee a job offer.</p><div class="policy-links"><a href="#terms">Service terms</a><a href="#refund">Refund conditions</a></div></article><aside class="prep-extra"><span class="eyebrow">OPTIONAL EXTRA</span><h3>Practice before the real conversation.</h3><p>Interview Prep is a separate live 45-minute session. Formula. Your story. Practice and feedback.</p><a href="/#prep">Explore Interview Prep · $150 ↗</a></aside><p class="not-ready-link"><a href="#connect">Not ready yet? Request next steps by email ↗</a></p>${interviewCommitment()}</div></div></section>${afterPurchase()}`;}


function storyBase(){const [city,tag]=cities[state.city],chapter=founderChapters[state.city],next=cities[state.city+1];return `<section class="hero story founder-story">${scene(state.city,true,'story')}<div class="founder-stage"><div class="founder-copy"><span class="eyebrow">THE FOUNDER’S STORY <span class="founder-count">${String(state.city+1).padStart(2,'0')} / ${String(cities.length).padStart(2,'0')}</span></span><h1>${city}<span class="founder-period">.</span></h1><h2>${tag}</h2><div class="founder-focus">${chapter.focus}</div><p class="founder-narrative">${chapter.body}</p><div class="founder-highlights">${chapter.highlights.map(t=>`<span>${t}</span>`).join('')}</div><div class="founder-controls"><button class="btn secondary" id="prev-city" ${state.city===0?'disabled':''} aria-label="Previous city">←</button>${next?`<button class="btn" id="next-city">Next: ${next[0]} →</button>`:'<a href="/#journey" class="btn">Begin your chapter →</a>'}</div></div><div class="founder-photo-mark" aria-hidden="true"><span>${String(state.city+1).padStart(2,'0')}</span><div>${avatar()}</div></div></div><nav class="route founder-route" aria-label="Founder story chapters">${cities.map((c,i)=>`<button data-city="${i}" class="${i===state.city?'active':''}" ${i===state.city?'aria-current="step"':''}><span>${i+1}</span>${c[0]}</button>`).join('')}</nav></section>`}

function how(){if(window.JobPlugHow)return window.JobPlugHow.render();const items=[['Purchase your package','Choose how you pay for Job Search through self-service enrollment. Both provide the same support over 30 counted service Business Days. US clients only; No consultations.'],['Complete your intake','After payment, share your background, résumé, and goals. Your information enters the service after purchase and intake.'],['Get set up within 24 hours','Receive your welcome guide and job-search inbox. Keep notifications enabled and review starred messages.'],['Your application journey begins','The service count starts on the first day we apply for you. Only days on which applications are submitted count. Weekends and holidays are excluded. We apply before and after holidays but the adjacent Business Days are excluded from your count.'],['Stay connected','We apply on Business Days and send a report every Friday. Reply to Interview requests within 24 to 48 hours and text us the company and role within 24 hours.'],['Prepare for your interview','Choose the optional $150 Interview Prep add-on for a focused live 45-minute session. Interview Prep is purchased separately from either payment option.']];return `<section class="content-page"><span class="eyebrow">Your journey, made clearer</span><h1 class="page-title">Real support.<br>At every next step.</h1><p>Purchase, complete your intake, and get plugged in. Your 30 counted service Business Days begin when we first apply for you.</p><div class="steps">${items.map(([h,p],i)=>`<article class="step"><div class="num">0${i+1}</div><h3>${h}</h3><p>${p}</p></article>`).join('')}</div><div class="notice">An interview commitment. No job-offer guarantee. See the <a href="#agreement">full agreement</a> for responsibilities, counted days, and refund provisions.</div><a class="btn" href="/#pricing">Choose my plan →</a> <a class="btn" href="/#prep">Explore Interview Prep →</a><div class="after-purchase"><h2>Already purchased?</h2><p>Complete your Career Profile Setup after purchase.</p>${handoff('intakeUrl','Open my intake','Intake link coming soon')}</div></section>`}
function prep(){return `<section class="hero cinematic-review prep-experience">${scene(0,true,'florida')}<div class="review-layout"><div class="review-story"><span class="eyebrow">Interview Prep / Optional add-on</span><h1>Turn your story<br>into your<br><em>strongest answer.</em></h1><p class="intro">A live 45-minute session built around your interview. Clear structure. Real practice. Personal feedback.</p><div class="review-guide">${avatar()}</div></div><article class="review-panel"><span class="eyebrow">LIVE INTERVIEW PREP</span><h2>Three parts.<br>One confident next step.</h2><div class="review-today"><span>45 minutes · Flat price</span><strong>$150<small>USD</small></strong></div><div class="prep-segments"><article><span>01</span><div><h3>The interview formula</h3><p>Build a clear structure for explaining your experience and answering with purpose.</p></div></article><article><span>02</span><div><h3>Your story bank</h3><p>Prepare five of your strongest projects and five challenges or growth experiences. We select the stories most relevant to your interview.</p></div></article><article><span>03</span><div><h3>Practice & feedback</h3><p>Rehearse your answers. Get focused feedback you can take into the conversation.</p></div></article></div><p class="prep-scope">The story bank is preparation material. The session focuses on selected stories rather than covering all ten in 45 minutes.</p><p class="prep-policy">Available separately for $150 or included with Job Search in the $399.99 paid-in-full bundle. No bundle discount with split payments. Non-refundable once accessed.</p>${handoff('interviewPrepUrl','Purchase Interview Prep')}<div class="already-purchased"><b>Already purchased?</b>${configuredUrl('calendlyUrl')?`<a href="${escapeHtml(configuredUrl('calendlyUrl'))}">Book your session ↗</a>`:'<span>Your scheduling link will be available after the booking connection is ready.</span>'}</div><div class="policy-links"><a href="#agreement">Service agreement</a><a href="/#pricing">Back to packages</a></div></article></div></section>`}

function help(){return `<section class="content-page"><span class="eyebrow">Clear answers. Real support.</span><h1 class="page-title">Frequently asked.<br>Clearly answered.</h1><p>JobPlug is self-service for clients in the United States. Choose your payment option, pay, and complete intake. Consultations are not offered.</p><div class="help-grid"><div>${[['Are split payments a different service?','The support is the same: 30 counted service Business Days. A payment reminder is sent 2 counted service Business Days before the Job Search with split payments balance charge. Job Search is $299.99 paid in full, saving $100. Job Search with split payments is $99.99 initially and $300 automatically charged on the 25th counted service Business Day, for a $399.99 total.'],['What counts as a service Business Day?','Monday through Friday, but only days JobPlug submits applications for you count. Weekends and holidays are excluded. We still apply on the Business Day immediately before and after a holiday. Those buffer days do not count toward the 30-day service window. The count starts on the first day we apply for you.'],['What happens after I purchase?','Complete JobPlug Career Profile Setup after payment. You receive a profile-received email. Setup follows within 24 hours. Your 30-Day Journey welcome email includes a personal welcome guide and dedicated Gmail inbox login. Keep notifications enabled. Check the Starred folder. Look for your email report every Friday.'],['What should I do when an interview comes in?','Reply promptly, within 24 to 48 hours, and text JobPlug the company and role within 24 hours. You may accept, reschedule, or decline. A qualifying Interview secured by JobPlug still counts toward the commitment if you decline it. That means the no-interview refund does not apply once a qualifying Interview has been secured. Repeated no-shows without notice may pause or end service.'],['Can I keep the job-search inbox?','At the end of your service window, the inbox login becomes yours to keep only when the package is paid in full. JobPlug stops managing it at that point.'],['Is a job guaranteed?','No. JobPlug commits to at least one qualifying Interview within the service window; the employer makes hiring decisions. See the full agreement for refund conditions. A qualifying Interview counts even if you decline it.'],['What is the Interview Prep add-on?','A $150 live 45-minute session built around your interview. Purchase through Shopify, then book through the JobPlug Calendly link. It is $150 as a separate purchase. A $399.99 paid-in-full bundle includes Job Search plus one Interview Prep session. The bundle discount does not apply to split payments. It is non-refundable once accessed. The session covers an interview formula then selected stories from your story bank then practice and feedback.'],['How do I get a Google sign-in code?','Text 832-975-3601 between 7 AM and 2 PM Eastern Time for Google sign-in codes.'],['How should I handle recruiter calls?','Your résumé uses your own phone number. Let unknown calls go to voicemail. Answer calls identifying a company or caller. For a surprise call ask for the role and location. Book the interview and request the job description by email. Text JobPlug the company and role within 24 hours. JobPlug verifies callers within 1 hour. You may tell employers that JobPlug helped you find the role.'],['How do renewals work?','At the end of your service we collect feedback and a testimonial and offer renewal. Renew Job Search for $299.99 paid in full. No discount code is needed.'],['Where do I pay or complete intake?','Use the checkout handoff for your selected package. Card details are handled by the checkout provider. After purchase complete Career Profile Setup using your intake link. Unconnected links are clearly marked unavailable. Journey preferences stay in this tab through reloads when browser storage is available. They are not an intake submission.']].map(([q,a])=>`<details><summary>${q}</summary><p>${a}</p></details>`).join('')}</div><aside class="contact-card"><span class="eyebrow">Service support</span><h2>Get in touch.</h2><p>For questions about your package, inbox, or next step:</p><p><a href="mailto:support@jobplug.co">support@jobplug.co ↗</a></p><p><a href="tel:+18329753601">832-975-3601</a></p><p style="font-size:12px">Text for interviews and important updates.<br>Monday through Friday all day.<br>Limited weekend replies.<br>Google sign-in codes: 7 AM to 2 PM ET.</p><p style="font-size:12px">Backup email:<br><a href="mailto:jobplugx@gmail.com">jobplugx@gmail.com</a></p><a class="btn" href="#terms">Explore the service terms →</a><p><a href="#renew">Returning client? Renew your journey ↗</a></p></aside></div></section>`}

function review(){const split=state.plan==='Secure Plus';return `<section class="hero cinematic-review">${scene(0,true,'florida')}<div class="review-layout"><div class="review-story"><span class="eyebrow">Your selected plan / ${split?'Split payments':'Pay in full'}</span><h1>A clear plan.<br>A new<br><em>beginning.</em></h1><p class="intro">Your next move starts with knowing exactly what comes next.</p><div class="review-guide">${avatar()}<div class="review-bubble">Let’s take the<br>next step together.</div></div><a class="link" href="/#pricing">← Back to your plan options</a></div><div class="review-panel"><div class="review-panel-head"><div><span class="eyebrow">YOUR PLAN AT A GLANCE</span><h2>Job Search</h2><p>${split?'Split payments':'Pay in full'}</p></div><a href="/#pricing">Change plan ↗</a></div><div class="review-today"><span>Due today</span><strong>${split?'$99.99':'$299.99'}<small>USD</small></strong></div>${split?`<div class="review-schedule"><div><i></i><b>Today</b><span>$99.99</span></div><div><i></i><b>25th service Business Day</b><span>$300</span></div></div><p class="schedule-copy">Your card is automatically charged $300 on the 25th counted service Business Day. A reminder is sent 2 counted service Business Days before the charge. Only qualifying application days count. Weekends and holidays are off. We apply on adjacent holiday Business Days but exclude those days from the count.</p>`:`<div class="review-paid"><span>✓</span> One payment. No later charges.</div>`}<div class="review-total"><span>Total cost</span><strong>${split?'$399.99':'$299.99'}</strong></div><div class="review-services"><span class="eyebrow">THE SUPPORT INCLUDED</span><p class="service-review-window">30 counted service Business Days, starting when we first apply for you.</p>${includes}</div><div class="review-preview"><b>Before you continue</b><p>Review the service agreement and payment schedule. Card details and payment authorization are handled at checkout. This page does not charge or store your card.</p></div><div class="policy-links"><a href="#terms">Service terms</a><a href="#refund">Refund & cancellation</a><a href="#privacy">Privacy</a></div>${handoff(split?'securePlusUrl':'secureUrl','Continue to checkout')}</div></div></section>`}

function complete(){return `<section class="content-page"><span class="eyebrow">Your next step</span><h1 class="page-title">Continue with JobPlug.</h1><p>No purchase has been confirmed on this page. Choose a plan to continue through checkout.</p><a class="btn" href="/#pricing">Choose my plan →</a><div class="after-purchase"><h2>Already purchased?</h2>${handoff('intakeUrl','Complete Career Profile Setup','Intake link coming soon')}</div></section>`}
function renew(){const active=Date.now()<=new Date('2026-12-01T00:00:00-05:00').getTime();return `<section class="hero cinematic-review">${scene(0,true,'florida')}<div class="review-layout"><div class="review-story"><span class="eyebrow">For returning clients</span><h1>Your next chapter<br>starts with<br><em>another connection.</em></h1><p class="intro">Tell us how your journey went. Then choose your next step with JobPlug.</p><div class="review-guide">${avatar()}</div></div><article class="review-panel"><span class="eyebrow">WELCOME BACK</span><h2>Continue your search.</h2><p>Renew Job Search for $299.99 paid in full. Add Interview Prep for a $399.99 bundle. Save $50. No code needed.</p><p>Share feedback about your completed service before you begin the next chapter.</p>${configuredUrl('renewalUrl')?handoff('renewalUrl','Continue to renewal'):'<a class="btn" href="/#pricing">View renewal plan options →</a>'}<div class="policy-links"><a href="#help">Contact support</a><a href="#agreement">Read service agreement</a></div></article></div></section>`}

const termsSections=[{"n": 1, "title": "About These Terms", "paragraphs": ["These Terms are an agreement between you (the Client) and JobPlug LLC based in Houston, Texas (JobPlug or we). They apply to Job Search, Job Search with split payments, Interview Prep products, and any related service we provide. JobPlug services are available in the United States only.", "By paying for or using a service you confirm you have read and agree to these Terms. This proposed version is intended for new purchases once connected to checkout. Viewing this page does not accept an agreement or take payment."]}, {"n": 2, "title": "Definitions", "paragraphs": ["Business Day: Monday to Friday, excluding holidays and the Business Day immediately before and immediately after each holiday. A day counts toward your service only when JobPlug submits applications for you.", "Service Window: 30 counted service Business Days for both Job Search with either payment option. Start Date: the first day JobPlug submits applications for you.", "Interview: a scheduled phone, video, or in-person interview with an employer or recruiter for a role we applied to for you. Online assessments and tests are tracked separately and are not Interviews.", "Enrollment Payment: $299.99 for Job Search paid in full or $99.99 for Job Search with split payments. Balance: the remaining $300 under Job Search with split payments, automatically charged on the 25th counted service Business Day."]}, {"n": 3, "title": "Packages and Pricing", "paragraphs": ["Job Search: $299.99 due today, saving $100 compared with the $399.99 split-payment total. No balance. Total $299.99.", "Job Search with split payments: $99.99 due today. The $300 balance is automatically charged on the 25th counted service Business Day. Total $399.99.", "Job Search plus one live 45-minute Interview Prep session: $399.99 paid in full. Purchased separately the services total $449.99. The bundle saves $50. This bundle discount does not apply to split payments.", "The service is identical in both options. Both cover 30 counted service Business Days. Prices may change for future purchases. The price shown when you enroll applies to you."]}, {"n": 4, "title": "Payment Before Work Begins", "paragraphs": ["You pay first. After you pay, you complete our intake form. Only then does your information enter our system and your work begin. Enrollment is self-service; consultations are not offered.", "After you complete JobPlug Career Profile Setup you receive a profile-received email. Setup is completed within 24 hours. The 30-Day Journey welcome email includes your personal welcome guide and dedicated Gmail job-search inbox login. JobPlug builds your résumés and applies Monday through Friday except holidays. We apply on the Business Days before and after a holiday but exclude those buffer days from the service count. Important emails are starred and you are notified. An email report is sent every Friday.", "Under Job Search with split payments you must keep a valid card on file. You authorize us to charge the $300 Balance to it on the 25th counted service Business Day. A reminder is sent 2 counted service Business Days before the charge. Payment must go through JobPlug’s official checkout or another method we approve in writing."]}, {"n": 5, "title": "Your 30 Business Days", "paragraphs": ["Your Service Window counts only Business Days on which JobPlug submits applications for you. Both Job Search with either payment option include 30 such counted service Business Days. Weekends and holidays do not count. We apply on the Business Day immediately before and immediately after each holiday but those two buffer days do not count.", "Your Start Date is the first day JobPlug submits applications for you.", "Your package expires at the end of your Service Window. We collect feedback and a testimonial before offering renewal. Renewal is $299.99 paid in full. No discount code is needed."]}, {"n": 6, "title": "Interview Commitment and Refund", "paragraphs": ["We commit to securing at least one Interview within your Service Window. If we do not, you may request a refund of everything you paid for the Interview Package.", "Request: send your request in writing to support@jobplug.co within 7 days after your Service Window closes.", "Review: we confirm no qualifying Interview was secured and that you met your responsibilities in Section 8.", "Payout: if approved, we refund the full amount to your original payment method in as little as 24 hours.", "Eligibility: refunds are not available if you did not complete intake or did not respond to Interview requests in time or did not attend scheduled Interviews (subject to the advance-notice exception in Section 12) or had services cancelled under Section 9. You may freely decline an Interview. A qualifying Interview secured by JobPlug still counts toward the interview commitment even if you decline it. Once such an Interview is secured the no-interview refund does not apply.", "Only remedy: this refund is the only exception to our no-refund policy. Otherwise Interview Package payments are non-refundable once work has begun."]}, {"n": 7, "title": "No Guarantee of a Job", "paragraphs": ["We do not promise or guarantee that you will be hired or receive an offer. Our commitment is to apply for you and secure Interviews within your Service Window. Hiring decisions belong to the employer alone. Examples and past results are illustrative and do not predict your outcome."]}, {"n": 8, "title": "Your Responsibilities", "paragraphs": ["Complete your intake promptly. We cannot begin until it is complete. Keep your résumé and profile accurate and current. You are responsible for the truth of everything submitted in your name.", "Respond to recruiters and to us as soon as possible and within 24 to 48 hours of an Interview request. Late replies risk losing the opportunity. Complete any assessments on time.", "Check the Starred folder in your job-search inbox and keep notifications enabled. You may skip the main inbox where rejection messages appear. Résumés use your own phone number and you handle recruiter calls. Text JobPlug the company and role within 24 hours of recruiter contact. You may tell employers that JobPlug helped you find the role.", "Pay any Balance when due. Interview Prep is a separate paid add-on and is not included in a payment option for Job Search. We are not responsible for opportunities lost because of delayed responses."]}, {"n": 9, "title": "Missed Payments and Removal", "paragraphs": ["Under Job Search with split payments the $300 Balance is automatically charged on the 25th counted service Business Day. A reminder is sent 2 counted service Business Days before the charge. If the Balance is not paid when due, we may hold active services including Interview coordination, employer communication, and access to job-search accounts and information. We may also cancel you from the program with no refund.", "If you stop responding or miss deadlines we may cancel your participation without refund."]}, {"n": 10, "title": "No Transfers and Expiry", "paragraphs": ["Packages belong only to the person who enrolled. They cannot be transferred or assigned or shared. They expire at the end of your Service Window."]}, {"n": 11, "title": "Career Direction Switch", "paragraphs": ["If you start seeing roles and want to completely change direction you get one switch at no cost. Each switch after the first costs $150. Your Service Window keeps running during any switch."]}, {"n": 12, "title": "Attendance and Conduct", "paragraphs": ["You may accept or reschedule or decline Interviews. Tell the recruiter or us ahead of time if you need to reschedule. A missed Interview with notice does not count against you. A qualifying Interview counts toward our commitment even if you decline it. See Section 6 for refund conditions.", "Repeated no-shows without notice may lead us to pause or end your package. Restarting requires buying a new package. We may end services if you act abusively or provide false information."]}, {"n": 13, "title": "Interview Prep Products", "paragraphs": ["The Interview Prep add-on is $150 flat and provides a live 45-minute session built around your Interview. It is purchased separately from Job Search with either payment option. Purchase it as a product through Shopify then book your time through JobPlug’s Calendly link. The session includes an interview formula then selected stories from a prepared bank of five strongest projects and five challenges or growth experiences then practice and feedback. It does not promise to cover all ten stories in the live session. The product is non-refundable once accessed.", "Interview Prep materials such as guides, cheat sheets, and study resources are digital. They are non-refundable once accessed. They are for your own use only and may not be copied, resold, or shared."]}, {"n": 14, "title": "Your Job-Search Account", "paragraphs": ["You authorize JobPlug to create and manage a job-search email account and to apply to roles in your name during your Service Window.", "Do not change the password or delete emails during your Service Window. Doing so can stop our work and does not extend your window.", "When your Service Window ends the login becomes yours to keep only if your package is paid in full. Clients who are not paid in full lose inbox access after service. JobPlug stops managing the account at that point. For Google sign-in codes text 832-975-3601 between 7 AM and 2 PM Eastern Time."]}, {"n": 15, "title": "Applying On Your Own", "paragraphs": ["You may apply to roles yourself. Duplicate applications to the same role can confuse employers. JobPlug is not responsible for issues caused by duplicates you submit."]}, {"n": 16, "title": "Your Current Employer", "paragraphs": ["If you are currently employed you are responsible for following your employer's rules on outside work and conflicts of interest. JobPlug is not responsible for any issue with your current employer."]}, {"n": 17, "title": "Communications Consent", "paragraphs": ["You agree to receive emails and text messages from JobPlug about your service. Message and data rates may apply."]}, {"n": 18, "title": "Accuracy and Responsibility", "paragraphs": ["You agree to cover JobPlug for any claim or loss caused by false or misleading information you provide."]}, {"n": 19, "title": "Payment Disputes", "paragraphs": ["Contact JobPlug before disputing any charge with your bank or card company. A chargeback filed without contacting us first ends your services."]}, {"n": 20, "title": "JobPlug Staff", "paragraphs": ["You agree not to hire or pay JobPlug staff directly for job-search services outside JobPlug during your Service Window and for 12 months after."]}, {"n": 21, "title": "Materials Ownership", "paragraphs": ["Your resume is yours to keep and use. JobPlug templates and guides and the Interview Playbook remain JobPlug property."]}, {"n": 22, "title": "Events Outside Our Control", "paragraphs": ["JobPlug is not responsible for delays caused by job board outages or employer hiring freezes or platform changes or other events outside our control."]}, {"n": 23, "title": "Limitation of Liability", "paragraphs": ["We provide career services on a best-efforts basis. To the extent the law allows JobPlug is not liable for indirect or incidental or consequential damages or lost wages or lost opportunities. Our total liability for any claim is limited to the amount you paid for the service at issue."]}, {"n": 24, "title": "Disputes", "paragraphs": ["If you have a concern contact JobPlug first at support@jobplug.co. We will work with you directly to resolve it."]}, {"n": 25, "title": "General", "paragraphs": ["Privacy: never share your Social Security number or bank details with anyone claiming to be a recruiter. Real recruiters never ask you to pay a fee. Changes: we may update these Terms for future purchases. The version in effect when you enrolled applies to you. Entire agreement: these Terms are the whole agreement for the services they cover. Severability: if any part of these Terms is found unenforceable the rest still applies. No waiver: if we do not enforce a term right away we do not give up the right to enforce it later. Governing law: Texas law applies. Contact: JobPlug LLC. Houston, Texas. Primary email: support@jobplug.co. Phone: 832-975-3601. Backup email: jobplugx@gmail.com."]}];
const briefSteps=[
 {title:'One service. Two ways to pay.',metric:'$299.99 <span>or</span> $99.99',lead:'Job Search: $299.99 paid in full. Job Search with split payments: $99.99 today plus $300 later. Total $399.99.',detail:'The Job Search with split payments balance charges on counted service Business Day 25. A reminder is sent 2 counted service Business Days before the charge. Both payment options include the same service.',link:'plans',label:'Compare plans'},
 {title:'Your time counts when we apply.',metric:'30 <span>counted days</span>',lead:'Application days. Not calendar days.',detail:'Only eligible Monday-to-Friday days with submitted applications count. Weekends and holidays do not count. We apply on the Business Day before and after a holiday but those days do not count either.',link:'agreement',label:'Read the service-day rules'},
