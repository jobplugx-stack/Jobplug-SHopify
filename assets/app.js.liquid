function skyline(city=0){let buildings='';for(let i=0;i<40;i++){let h=70+((i*53+city*17)%170),x=i*37;let windows='';for(let y=0;y<h-20;y+=17)for(let j=0;j<3;j++){if((i+y+j)%4)windows+=`<rect x="${x+7+j*8}" y="${410-h+y+10}" width="3" height="5" fill="${(i+j)%3?'#ecc47d':'#72a5a8'}" opacity="${.2+((i+y)%5)/8}"/>`;}buildings+=`<rect x="${x}" y="${410-h}" width="31" height="${h}" fill="${i%2?'#123a46':'#092c39'}"/>${windows}`;}let landmark=city===5?'<path d="M0 250L180 80 300 185 440 40 650 250 830 100 1100 260" fill="#547985" opacity=".55"/>':city===0?'<path d="M750 310v-100h30v-20h15v-20h10v-30h10v30h10v20h15v20h30v100z" fill="#b7b4a0" opacity=".7"/>':city===6?'<path d="M910 300V120h12V95h9V40h3v55h9v25h12v180z" fill="#6b7775"/>':'';return `<svg viewBox="0 0 1500 600" preserveAspectRatio="xMidYMax slice" aria-hidden="true">${landmark}${buildings}<path d="M0 410H1500V600H0Z" fill="#0b3540" opacity=".8"/><path d="M0 420C350 430 390 480 680 460S1050 450 1500 520" stroke="#dba863" stroke-width="2" fill="none" opacity=".4"/><path class="gold-path" d="M1450 460C1200 260 1250 570 900 430S810 230 600 370S450 510 250 390"/></svg>`}
function lightTrails(){return `<svg class="light-trails" viewBox="0 0 1500 800" preserveAspectRatio="none" aria-hidden="true"><defs><filter id="trail-glow"><feGaussianBlur stdDeviation="5"/></filter></defs><g class="trail-halo"><path d="M580 770C850 620 1500 740 1250 460S710 470 950 250S1430 260 1470 60"/><path d="M1510 690C1250 560 880 690 1030 480S1450 340 1300 180"/></g><g class="trail-lines"><path d="M580 770C850 620 1500 740 1250 460S710 470 950 250S1430 260 1470 60"/><path d="M1510 690C1250 560 880 690 1030 480S1450 340 1300 180"/></g><g class="trail-pulse"><path d="M580 770C850 620 1500 740 1250 460S710 470 950 250S1430 260 1470 60"/><path d="M1510 690C1250 560 880 690 1030 480S1450 340 1300 180"/></g></svg>`}
function scene(city=0,photo=true,kind='world'){const source=kind==='story'?window.jobplugAsset('assets/city-'+(cities[city]?.[5]??city)+'.jpg'):'{{ 'city-hero.png' | asset_url }}';return `<div class="scene scene-${city} photographic ${kind}-scene"><img class="photo" src="${source}" alt="" onerror="this.onerror=null;this.src='{{ 'city-hero.png' | asset_url }}'"><div class="sun"></div><div class="cloud"></div>${lightTrails()}<div class="scene-grain"></div></div>`}


