.hs-progress button{min-height:44px;min-width:0;padding:14px 0}
.hs-progress span{height:4px}
.hs-control-row{display:grid;grid-template-columns:minmax(37px,.5fr) minmax(0,1fr) 96px;gap:9px;margin-top:0;align-items:center}
.hs-counter{font-size:11px;letter-spacing:1px;white-space:nowrap}
.hs-counter b{font-size:15px}
.hs-play{min-height:44px;width:100%;font-size:12px;line-height:1.25;padding:9px 8px;white-space:normal;background:#12343ce8}
.hs-arrows{gap:8px}
.hs-arrows button{width:44px;height:44px;min-width:44px;min-height:44px;font-size:21px}
.hs-swipe-hint{font-size:11px;line-height:1.5;margin:12px 0 0;color:#bdd1c4}
.hs-action{min-height:44px;align-items:center;font-size:13px;padding:12px 16px;margin-top:6px}
.hs-summary{padding:18px max(18px,5vw) 40px}
.hs-summary details{padding:18px}
.hs-summary summary{font-size:14px;line-height:1.5;min-height:44px;align-content:center}
.hs-summary h2{font-size:19px;line-height:1.3}
.hs-summary p{font-size:14px;line-height:1.65}
.hs-summary a{font-size:13px;line-height:1.5;min-height:44px;padding:10px 0}
body:has(#jobplug-how-story) .quick-plug-fab{display:none}
}
@media(max-width:360px){
.hs-experience{padding-left:16px;padding-right:16px}
.hs-copy h1{font-size:30px}
.hs-ui{width:calc(100% - 24px);margin-right:18px;padding:12px}
.hs-guide{width:90px;height:118px;right:-3px}
.hs-control-row{grid-template-columns:34px minmax(0,1fr) 96px;gap:6px}
.hs-play{font-size:11px}
.hs-option-plus{padding-right:32px}
.hs-visual{padding-bottom:28px}
}
@media(max-width:700px){.hs-ui{padding-bottom:36px}.hs-guide{bottom:-14px}.hs-illustration-note{max-width:calc(100% - 65px)}.hs-small-check{max-width:calc(100% - 55px)}}
@media(max-width:360px){.hs-progress{gap:4px}}
/* A concrete report example. Every sample detail is explicitly fictional. */
.hs-report-sample .hs-window-top>span{font-size:8px;letter-spacing:1px;line-height:1.6;color:#e2ca98}.hs-sample-entry{padding:16px;border:1px solid #c6aa7340;border-radius:8px;background:#071f2245}.hs-sample-label{display:block;font-size:8px;letter-spacing:1.3px;color:#c6aa73;margin-bottom:9px}.hs-sample-entry h3,.hs-sample-next h3{font-family:'Space Grotesk',Arial,sans-serif;font-size:17px;font-weight:500;line-height:1.35;letter-spacing:-.4px;margin:0 0 7px;color:#f3f0e8}.hs-sample-entry>p{font-size:11px;color:#d4e2d8;margin:0 0 14px;line-height:1.6}.hs-sample-entry>p>span{color:#a9c0b2;font-size:10px}.hs-sample-status{border-top:1px solid #c6aa7330;padding-top:12px;display:flex;gap:12px;justify-content:space-between;align-items:center}.hs-sample-status>span{font-size:10px;color:#a9c0b2}.hs-sample-status>b{font-size:10px;font-weight:500;color:#e1c590;line-height:1.5}.hs-sample-next{margin-top:17px;padding:0 2px 0 14px;border-left:2px solid #c6aa73}.hs-sample-next h3{font-size:15px}.hs-sample-next p{font-size:11px;line-height:1.7;color:#bdd0c3;margin:0}.hs-report-sample .hs-illustration-note{font-size:9px;line-height:1.65;margin-top:16px;max-width:90%}
@media(max-width:700px){.hs-report-sample .hs-window-top>span{font-size:9px;line-height:1.5;letter-spacing:.7px}.hs-sample-entry{padding:13px}.hs-sample-label{font-size:9px;letter-spacing:.8px;margin-bottom:7px}.hs-sample-entry h3{font-size:17px}.hs-sample-entry>p{font-size:12px;margin-bottom:11px}.hs-sample-entry>p>span{font-size:11px}.hs-sample-status{display:block;padding-top:10px}.hs-sample-status>span{font-size:11px;display:block;margin-bottom:4px}.hs-sample-status>b{font-size:12px}.hs-sample-next{margin-top:14px;padding-left:12px}.hs-sample-next h3{font-size:16px}.hs-sample-next p{font-size:12px;line-height:1.6}.hs-report-sample .hs-illustration-note{font-size:10px;line-height:1.6;max-width:calc(100% - 60px)}}
