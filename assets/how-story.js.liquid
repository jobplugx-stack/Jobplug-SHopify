function render(){return `<section id="jobplug-how-story" class="hs-experience" aria-label="How JobPlug works"><div class="hs-bg"><img src="{{ 'city-hero.png' | asset_url }}" alt=""><div class="hs-atmosphere"></div></div><div class="hs-top"><span>HOW JOBPLUG WORKS</span><a href="#plans">View plans ↗</a></div><div class="hs-slides">${scenes.map((s,i)=>`<section class="hs-slide" data-hs-slide="${i}" ${i?'hidden':''} role="group" aria-roledescription="slide" aria-label="${i+1} of ${scenes.length}: ${s.label}"><div class="hs-copy"><span class="hs-eyebrow">${s.tag}</span><h1>${s.title}</h1><p>${s.copy}</p><p class="hs-detail">${s.detail}</p>${i===5?'<a class="hs-action" href="#plans">Choose my next step ↗</a>':''}</div><div class="hs-visual" aria-label="${s.label}">${visual(s.visual)}${guide}<svg class="hs-connection" viewBox="0 0 600 150" aria-hidden="true"><path d="M0 130C180 10 350 180 590 40"/><path class="hs-current" d="M0 130C180 10 350 180 590 40"/></svg></div></section>`).join('')}</div><div class="hs-controls"><div class="hs-progress" aria-label="Choose a step">${scenes.map((s,i)=>`<button data-hs-go="${i}" aria-label="Step ${i+1}: ${s.label}" ${i===0?'aria-current="step"':''}><span></span></button>`).join('')}</div><div class="hs-control-row"><span class="hs-counter"><b data-hs-current>01</b> / 06</span><button class="hs-play" data-hs-play aria-pressed="false">Play the journey</button><div class="hs-arrows"><button data-hs-prev aria-label="Previous step" disabled>←</button><button data-hs-next aria-label="Next step">→</button></div></div><p class="hs-swipe-hint">Swipe or use the arrows. Move at your own pace.</p><div class="hs-announcement" aria-live="polite" aria-atomic="true"></div></div></section><section class="hs-summary"><details><summary>The journey at a glance</summary><ol>${scenes.map(s=>`<li><h2>${s.title.replace(/<br>/g,' ')}</h2><p>${s.copy}</p><p>${s.detail}</p></li>`).join('')}</ol><a href="#agreement">Read the full service agreement ↗</a></details></section>${typeof afterPurchase==='function'?afterPurchase():''}`;}
