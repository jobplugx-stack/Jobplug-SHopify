function mount(){unmount();const root=document.getElementById('jobplug-how-story');if(!root)return;const controller=new AbortController(),opts={signal:controller.signal};const slides=[...root.querySelectorAll('[data-hs-slide]')],segments=[...root.querySelectorAll('[data-hs-go]')],prev=root.querySelector('[data-hs-prev]'),next=root.querySelector('[data-hs-next]'),play=root.querySelector('[data-hs-play]'),counter=root.querySelector('[data-hs-current]'),announce=root.querySelector('.hs-announcement');let index=0,timer=null,playing=false,start=null;const media=window.matchMedia('(prefers-reduced-motion: reduce)');const reduced=()=>media.matches||document.body.classList.contains('no-motion');function clear(){if(timer!==null){clearTimeout(timer);timer=null;}}function stop(){playing=false;clear();play.setAttribute('aria-pressed','false');play.textContent=index===5?'Replay the journey':'Play the journey';root.classList.remove('hs-playing');}function syncMotion(){if(reduced())stop();play.disabled=reduced();play.title=reduced()?'Automatic playback is unavailable while reduced motion is enabled. Use the step controls.':'';}function schedule(){clear();if(playing&&!document.hidden&&!reduced())timer=setTimeout(()=>show(index+1,true),7000);}function show(n,automatic=false){if(n<0||n>=slides.length){stop();return;}const focused=document.activeElement;const departingSlide=slides[index];const focusWasInDeparting=n!==index&&departingSlide.contains(focused);if(!automatic)stop();index=n;if(!playing)play.textContent=index===5?'Replay the journey':'Play the journey';slides.forEach((slide,i)=>{slide.hidden=i!==index;});segments.forEach((button,i)=>{if(i===index)button.setAttribute('aria-current','step');else button.removeAttribute('aria-current');button.classList.toggle('hs-complete',i<index);});prev.disabled=index===0;next.disabled=index===slides.length-1;counter.textContent=String(index+1).padStart(2,'0');if(!automatic&&(focusWasInDeparting||(focused===prev&&prev.disabled)||(focused===next&&next.disabled)))segments[index].focus({preventScroll:true});if(!automatic)announce.textContent=`Step ${index+1} of ${slides.length}. ${scenes[index].label}.`;if(index===slides.length-1)stop();else schedule();}prev.addEventListener('click',()=>show(index-1),opts);next.addEventListener('click',()=>show(index+1),opts);segments.forEach(b=>b.addEventListener('click',()=>show(Number(b.dataset.hsGo)),opts));play.addEventListener('click',()=>{if(playing){stop();return;}if(reduced())return;if(index===slides.length-1)show(0);playing=true;play.setAttribute('aria-pressed','true');play.textContent='Pause the journey';root.classList.add('hs-playing');schedule();},opts);root.addEventListener('keydown',e=>{if(e.altKey||e.ctrlKey||e.metaKey||e.target.closest('input,textarea,select'))return;if(e.key==='ArrowRight'){e.preventDefault();show(Math.min(index+1,slides.length-1));}if(e.key==='ArrowLeft'){e.preventDefault();show(Math.max(index-1,0));}},opts);const track=root.querySelector('.hs-slides');track.addEventListener('pointerdown',e=>{if(e.target.closest('a,button,input,select,textarea'))return;start={x:e.clientX,y:e.clientY,id:e.pointerId};},opts);track.addEventListener('pointerup',e=>{if(!start||start.id!==e.pointerId)return;const dx=e.clientX-start.x,dy=e.clientY-start.y;start=null;if(Math.abs(dx)>55&&Math.abs(dx)>Math.abs(dy)*1.5)show(Math.max(0,Math.min(slides.length-1,index+(dx<0?1:-1))));},opts);track.addEventListener('pointercancel',()=>{start=null;},opts);document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();},opts);media.addEventListener('change',syncMotion,opts);const observer=new MutationObserver(syncMotion);observer.observe(document.body,{attributes:true,attributeFilter:['class']});syncMotion();cleanup=()=>{clear();controller.abort();observer.disconnect();};}
window.JobPlugHow={render,mount,unmount};
