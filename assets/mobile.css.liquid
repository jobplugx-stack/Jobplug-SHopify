 .content-page{padding-top:112px}.content-page>p,.policy-content p{font-size:15px;line-height:1.8}.help-grid summary{font-size:16px;line-height:1.5;padding-top:18px;padding-bottom:18px}.help-grid details p{font-size:15px;line-height:1.8}.contact-card{padding:24px}.contact-card p,.contact-card p[style]{font-size:14px!important;line-height:1.8}.contact-card a{overflow-wrap:anywhere}.agreement-access{position:relative!important;top:auto;font-size:12px;line-height:1.6}.agreement-access a{display:inline-flex;align-items:center;min-height:44px}.hub-heading{padding-top:35px}.terms-hub>.hub-guide{top:230px;width:75px}.terms-hub .hub-heading h1{font-size:36px;max-width:85%}.hub-heading>p{font-size:15px!important;line-height:1.8}.terms-topic p{font-size:14px;line-height:1.7}.topic-accordion>summary{font-size:21px;line-height:1.35}.topic-answers p{font-size:15px;line-height:1.8}.topic-answers h3{font-size:16px;line-height:1.5}.terms-index button{font-size:13px;min-height:44px;align-items:center}.terms-clause p{font-size:15px;line-height:1.85}.terms-header>p{font-size:15px}.terms-version{font-size:11px}.terms-source{font-size:13px}.terms-summary-grid p{font-size:14px}.terms-clause h2{overflow-wrap:anywhere}.terms-index{max-height:330px}
