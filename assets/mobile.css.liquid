 .opportunity-wall{padding:50px 0}.opportunity-wall>p{font-size:15px;line-height:1.7}.opportunity-chip{font-size:22px;padding:24px 28px}.opportunity-wall>small{font-size:12px;line-height:1.7}.opportunity-streams{margin:28px 0;gap:12px}footer{padding:38px 20px 24px}footer>div{display:grid;grid-template-columns:1fr 1fr;gap:4px 16px}footer>div a{font-size:13px;min-height:44px;display:flex;align-items:center;line-height:1.6}footer small{font-size:12px;line-height:1.7}footer .motion{min-height:44px;font-size:13px;margin-top:16px}
