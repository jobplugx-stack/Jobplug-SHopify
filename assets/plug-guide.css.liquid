#jobplug-faq-guide{font-family:Inter,Arial,sans-serif;color:#f3f0e8}.pg-launcher{position:fixed;right:24px;bottom:calc(94px + env(safe-area-inset-bottom));z-index:19;display:flex;align-items:center;gap:9px;min-height:54px;padding:6px 16px 6px 8px;border:1px solid #c6aa7370;border-radius:32px;background:#0a2b30ed;backdrop-filter:blur(15px);box-shadow:0 10px 35px #0005;color:#ead4a6;cursor:pointer;transition:transform .2s,border-color .2s}.pg-launcher:hover{transform:translateY(-3px);border-color:#c6aa73}.pg-launcher img{width:38px;height:44px;object-fit:contain;filter:drop-shadow(0 3px 5px #0005)}.pg-launcher span{font:500 11px Inter,Arial,sans-serif}.pg-dialog{box-sizing:border-box;width:min(640px,calc(100vw - 32px));max-height:calc(100dvh - 40px);padding:28px;border:1px solid #c6aa7370;border-radius:18px;background:radial-gradient(ellipse at 85% 0%,#35565a99,transparent 65%),#071f22;color:#f3f0e8;box-shadow:0 25px 100px #0008;overflow:auto;overscroll-behavior:contain}.pg-dialog::backdrop{background:#031419bf;backdrop-filter:blur(5px)}.pg-dialog-header{display:flex;align-items:center;gap:13px;position:relative;padding-right:42px}.pg-header-guide{flex-shrink:0;width:55px;height:65px}.pg-header-guide img{width:100%;height:100%;object-fit:contain}.pg-eyebrow{display:block;font-size:9px;letter-spacing:1.7px;color:#c6aa73;margin-bottom:9px}.pg-dialog-header h2{font-family:'Space Grotesk',Arial,sans-serif;font-size:29px;font-weight:500;letter-spacing:-1px;line-height:1.1;margin:0}.pg-close{position:absolute;right:0;top:5px;width:40px;height:40px;border:1px solid #b1c7b73a;background:#0d303580;border-radius:50%;color:#e4d1a7;font-size:25px;cursor:pointer}.pg-dialog #pg-description{font-size:12px;line-height:1.75;color:#b3cbbf;margin:19px 0 23px}.pg-question-list{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pg-question-list button{min-height:61px;padding:14px 15px;display:flex;align-items:center;justify-content:space-between;gap:12px;color:#dfebe3;font:500 12px/1.5 Inter,Arial,sans-serif;text-align:left;border:1px solid #a1bca440;border-radius:9px;background:#35565a35;cursor:pointer;transition:background .2s,border-color .2s}.pg-question-list button>span{font-size:16px;color:#c6aa73;flex-shrink:0}.pg-question-list button:hover,.pg-question-list button[aria-pressed=true]{border-color:#c6aa73;background:#c6aa7315}.pg-answer{margin-top:23px;padding:23px;border:1px solid #c6aa7350;border-radius:12px;background:linear-gradient(130deg,#35565a60,#0b2c31ba);scroll-margin:15px}.pg-answer[hidden]{display:none}.pg-answer h3{font:500 24px/1.2 'Space Grotesk',Arial,sans-serif;letter-spacing:-.6px;margin:0 0 15px}.pg-answer-copy{font-size:14px;line-height:1.8;color:#cfdfd4;margin:0 0 18px}.pg-related{color:#e1c68e;font-size:12px;text-decoration:underline;text-underline-offset:4px;line-height:1.7}.pg-audio{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:22px;padding-top:18px;border-top:1px solid #a4bfa72e}.pg-read,.pg-stop{font:500 11px/1.5 Inter,Arial,sans-serif;padding:10px 14px;min-height:40px;border-radius:24px;border:1px solid #c6aa7370;background:#0d3035aa;color:#e0ca9a;cursor:pointer}.pg-stop{background:#c6aa7320}.pg-read:disabled{opacity:.5;cursor:not-allowed}.pg-stop[hidden]{display:none}.pg-audio-status{display:block;width:100%;color:#a9c3b3;font-size:10px;line-height:1.6}.pg-help{margin-top:24px;padding-top:20px;border-top:1px solid #c6aa7330;display:flex;flex-direction:column;gap:10px}.pg-help>span{font-size:12px;color:#b1c7ba}.pg-help>a{font-size:12px;color:#e0c68f;text-decoration:underline;text-underline-offset:4px;width:fit-content;line-height:1.7}.pg-launcher:focus-visible,.pg-dialog button:focus-visible,.pg-dialog a:focus-visible,.pg-answer h3:focus-visible{outline:2px solid #e6cc94;outline-offset:4px}.pg-dialog button,.pg-dialog a{-webkit-tap-highlight-color:transparent}
@media(max-width:700px){.pg-launcher{right:16px;bottom:calc(88px + env(safe-area-inset-bottom));min-width:52px;min-height:56px;padding:5px 8px;border-radius:29px}.pg-launcher img{width:34px;height:43px}.pg-launcher span{display:none}.pg-dialog{width:calc(100vw - 24px);max-height:calc(100dvh - 24px);padding:22px 18px;border-radius:15px}.pg-dialog-header{gap:10px;padding-right:42px}.pg-header-guide{width:44px;height:57px}.pg-dialog-header h2{font-size:25px}.pg-eyebrow{font-size:8px;letter-spacing:1.3px}.pg-close{min-width:44px;min-height:44px;top:1px}.pg-dialog #pg-description{font-size:12px;line-height:1.7;margin:17px 0 20px}.pg-question-list{gap:8px}.pg-question-list button{font-size:12px;min-height:70px;padding:12px 10px;gap:7px}.pg-question-list button>span{font-size:14px}.pg-answer{padding:18px;margin-top:19px}.pg-answer h3{font-size:23px}.pg-answer-copy{font-size:14px;line-height:1.75}.pg-related{font-size:12px;display:inline-block;min-height:44px;padding:9px 0}.pg-audio{margin-top:10px;padding-top:16px;gap:8px}.pg-read,.pg-stop{min-height:44px;font-size:12px;padding:10px 13px}.pg-audio-status{font-size:11px}.pg-help>a{font-size:13px;min-height:36px;padding:5px 0}.pg-help>span{font-size:12px}.pg-help{gap:6px}body:has(#jobplug-how-story) .pg-launcher,body:has(.founder-story) .pg-launcher{position:static;margin:0 6% 24px auto;width:fit-content;display:flex;padding:7px 15px 7px 8px}body:has(#jobplug-how-story) .pg-launcher span,body:has(.founder-story) .pg-launcher span{display:inline;font-size:12px}}
@media(max-width:350px){.pg-question-list{grid-template-columns:1fr}.pg-question-list button{min-height:48px}.pg-dialog-header h2{font-size:23px}}
@media(prefers-reduced-motion:reduce){.pg-launcher,.pg-question-list button{transition:none}.pg-launcher:hover{transform:none}}body.no-motion .pg-launcher,body.no-motion .pg-question-list button{transition:none}body.no-motion .pg-launcher:hover{transform:none}
.pg-dialog-header{position:sticky;top:0;z-index:5;background:#0b2b30;padding-top:9px;padding-bottom:9px;border-radius:8px;box-shadow:0 8px 18px #071f2270}.pg-close{top:12px}
@media(max-width:700px){.pg-launcher{position:static;display:flex;width:fit-content;min-height:56px;margin:0 6% 24px auto;padding:7px 15px 7px 8px}.pg-launcher span{display:inline;font-size:12px}.pg-dialog-header{top:0;padding-top:8px;padding-bottom:8px}.pg-close{top:10px}}
