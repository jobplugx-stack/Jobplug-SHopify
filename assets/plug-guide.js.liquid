(function(){
'use strict';
const questions=[
 {id:'plans',label:'Which plan fits me?',title:'One service. Two ways to pay.',answer:'Job Search is $299 paid in full. Job Search with split payments is $99 initially plus $300 automatically charged on the 25th counted service Business Day. Job Search with split payments totals $399. A reminder is sent 2 counted service Business Days before the charge. Both payment options provide the same service. Interview Prep is purchased separately.',route:'#plans',link:'Compare the plans'},
 {id:'days',label:'How do the 30 days count?',title:'Only eligible application days count.',answer:'Your 30 counted service Business Days start when JobPlug first submits applications for you. Only days with applications submitted for you count. Weekends and holidays are off. JobPlug applies on the Business Day before and after a holiday but those buffer days are excluded from your count.',route:'#terms',link:'Understand the service window'},
 {id:'interviews',label:'What is the interview commitment?',title:'An interview commitment. No job guarantee.',answer:'JobPlug commits to at least one qualifying Interview within your service window. You may freely decline an Interview. A qualifying Interview secured by JobPlug still counts even if you decline it. Once one is secured the no-interview refund does not apply. If no qualifying Interview is secured you may request a refund within 7 days after the window closes subject to the agreement’s eligibility conditions. Employers make hiring decisions.',route:'#agreement',link:'Read the full refund conditions'},
 {id:'inbox',label:'Can I keep my inbox?',title:'Your inbox after the service.',answer:'When your service window ends the dedicated job-search inbox login becomes yours to keep only if your package is paid in full. Clients who are not paid in full lose inbox access after service. During the service keep notifications enabled and check Starred. Do not change the password or delete emails while JobPlug manages the account.',route:'#help',link:'Get inbox support'},
 {id:'intake',label:'I paid. What happens next?',title:'Complete your Career Profile Setup.',answer:'After purchase complete JobPlug Career Profile Setup. You receive a profile-received email. Setup follows within 24 hours after intake. Your 30-Day Journey welcome email includes a personal guide and your dedicated job-search inbox login. The counted service window begins on the first day JobPlug applies for you.',route:'#how',link:'See the after-purchase steps'},
 {id:'prep',label:'What is Interview Prep?',title:'Focused preparation for your interview.',answer:'Interview Prep is a separate $149 add-on. It is a live 45-minute session built around your interview. The session covers an interview formula then selected stories from a prepared bank of five strongest projects and five challenges or growth experiences then practice and feedback. It does not promise to cover all ten stories during the session. It is non-refundable once accessed. Purchase first then use the provided scheduling link.',route:'#prep',link:'Explore Interview Prep'}
];
let teardown=null;
function mount(){if(document.getElementById('jobplug-faq-guide'))return;const container=document.createElement('div');container.id='jobplug-faq-guide';container.innerHTML=`<button class="pg-launcher" type="button" aria-label="Ask JobPlug" title="Ask JobPlug" aria-haspopup="dialog" aria-controls="pg-dialog"><img src="{{ 'plug-guide.png' | asset_url }}" alt=""><span>Ask JobPlug</span></button><dialog id="pg-dialog" class="pg-dialog" aria-labelledby="pg-heading" aria-describedby="pg-description"><div class="pg-dialog-header"><div class="pg-header-guide"><img src="{{ 'plug-guide.png' | asset_url }}" alt="" aria-hidden="true"></div><div><span class="pg-eyebrow">YOUR JOBPLUG GUIDE</span><h2 id="pg-heading">A clearer next step.</h2></div><button class="pg-close" type="button" aria-label="Close JobPlug guide">×</button></div><p id="pg-description">An automated FAQ guide with answers from JobPlug’s service details. For personal help contact the support team.</p><div class="pg-question-list" role="group" aria-label="Choose a question">${questions.map(q=>`<button type="button" data-pg-question="${q.id}">${q.label}<span aria-hidden="true">↗</span></button>`).join('')}</div><section class="pg-answer" aria-labelledby="pg-answer-title" hidden><span class="pg-eyebrow">YOUR ANSWER</span><h3 id="pg-answer-title"></h3><p class="pg-answer-copy"></p><a class="pg-related" href="#help"></a><div class="pg-audio"><button class="pg-read" type="button">Read answer aloud</button><button class="pg-stop" type="button" hidden>Stop reading</button><span class="pg-audio-status" role="status"></span></div></section><div class="pg-help"><span>Need help with your own service?</span><a class="pg-support" href="#help">Contact JobPlug support ↗</a><a href="mailto:support@jobplug.co">support@jobplug.co</a></div></dialog>`;document.body.append(container);
const controller=new AbortController(),opts={signal:controller.signal},launcher=container.querySelector('.pg-launcher'),dialog=container.querySelector('dialog'),close=container.querySelector('.pg-close'),answerBox=container.querySelector('.pg-answer'),answerTitle=container.querySelector('#pg-answer-title'),answerCopy=container.querySelector('.pg-answer-copy'),related=container.querySelector('.pg-related'),read=container.querySelector('.pg-read'),stop=container.querySelector('.pg-stop'),status=container.querySelector('.pg-audio-status');let selected=null,returnFocus=null,utterance=null,speaking=false,readSession=0,restoreFocus=true;
const speechAvailable=typeof window.speechSynthesis!=='undefined'&&typeof window.SpeechSynthesisUtterance==='function';
function resetSpeech(){speaking=false;utterance=null;read.disabled=!speechAvailable;read.textContent='Read answer aloud';stop.hidden=true;}
function stopReading(){readSession++;const hadSpeech=speaking;if(speaking&&speechAvailable)window.speechSynthesis.cancel();resetSpeech();if(hadSpeech)status.textContent='Reading stopped.';}
function closeGuide(){stopReading();if(dialog.open)dialog.close();}
function selectQuestion(id){const q=questions.find(item=>item.id===id);if(!q)return;stopReading();selected=q;container.querySelectorAll('[data-pg-question]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.pgQuestion===id)));answerTitle.textContent=q.title;answerCopy.textContent=q.answer;related.textContent=q.link+' ↗';related.href=q.route;answerBox.hidden=false;status.textContent=speechAvailable?'Audio plays only when you choose it.':'Reading aloud is not available in this browser.';answerTitle.tabIndex=-1;answerTitle.focus({preventScroll:true});answerBox.scrollIntoView({behavior:'auto',block:'nearest'});}
launcher.addEventListener('click',()=>{if(typeof dialog.showModal!=='function'){window.location.hash='help';return;}returnFocus=document.activeElement;restoreFocus=true;dialog.showModal();close.focus({preventScroll:true});},opts);
close.addEventListener('click',closeGuide,opts);
dialog.addEventListener('cancel',()=>stopReading(),opts);
dialog.addEventListener('close',()=>{stopReading();if(restoreFocus){if(returnFocus&&returnFocus.isConnected)returnFocus.focus({preventScroll:true});else launcher.focus({preventScroll:true});}},opts);
dialog.addEventListener('click',event=>{if(event.target!==dialog)return;const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)closeGuide();},opts);
container.querySelectorAll('[data-pg-question]').forEach(button=>{button.setAttribute('aria-pressed','false');button.addEventListener('click',()=>selectQuestion(button.dataset.pgQuestion),opts);});
container.querySelectorAll('.pg-related,.pg-support').forEach(link=>link.addEventListener('click',()=>{restoreFocus=false;closeGuide();},opts));
read.disabled=!speechAvailable;
read.addEventListener('click',()=>{if(!selected||!speechAvailable)return;stopReading();const session=++readSession;try{utterance=new window.SpeechSynthesisUtterance(selected.title+' '+selected.answer);utterance.lang='en-US';utterance.rate=1;utterance.onend=()=>{if(session!==readSession)return;resetSpeech();status.textContent='Finished reading.';};utterance.onerror=event=>{if(session!==readSession)return;resetSpeech();status.textContent=event.error==='canceled'||event.error==='interrupted'?'Reading stopped.':'Audio is unavailable right now. The full answer is above.';};speaking=true;read.disabled=true;stop.hidden=false;status.textContent='Reading the answer aloud.';window.speechSynthesis.speak(utterance);}catch{resetSpeech();status.textContent='Audio is unavailable right now. The full answer is above.';}},opts);
stop.addEventListener('click',stopReading,opts);
window.addEventListener('hashchange',()=>{if(dialog.open){restoreFocus=false;closeGuide();}},opts);
document.addEventListener('visibilitychange',()=>{if(document.hidden)stopReading();},opts);
teardown=()=>{stopReading();controller.abort();container.remove();teardown=null;};
}
function unmount(){if(teardown)teardown();}
window.JobPlugGuide={mount,unmount};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mount,{once:true});else mount();
})();
