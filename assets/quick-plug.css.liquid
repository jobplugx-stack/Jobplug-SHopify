.quick-plug-fab{position:fixed;right:24px;bottom:22px;z-index:20;padding:15px 21px;border:1px solid #ead1a4;border-radius:50px;background:#C6AA73;color:#071F22;box-shadow:0 8px 35px #0005;font:600 13px Inter,Arial,sans-serif;display:flex;gap:10px;align-items:center}.quick-plug-fab>span{font-size:19px}.quick-plug-fab:hover{background:#dfc38e;transform:translateY(-2px)}.quick-is-open{overflow:hidden}.quick-plug-dialog{box-sizing:border-box;width:min(580px,calc(100vw - 32px));max-height:calc(100dvh - 32px);overflow:auto;padding:36px;color:#F3F0E8;background:linear-gradient(145deg,#1b3d40f7,#071f22fc);border:1px solid #c6aa7390;border-radius:18px;box-shadow:0 30px 100px #0008;backdrop-filter:blur(24px)}.quick-plug-dialog::backdrop{background:#001316c9;backdrop-filter:blur(7px)}.quick-close{position:absolute;right:16px;top:12px;background:none;border:0;color:#e1c995;font-size:30px;width:42px;height:42px}.quick-plug-dialog .eyebrow{font-size:10px;margin-top:9px;color:#C6AA73}.quick-plug-dialog h2{font:600 36px/1.1 'Space Grotesk',Arial,sans-serif;letter-spacing:-1.5px;margin:22px 0 14px}.quick-intro{font-size:14px;line-height:1.65;color:#b9ceca;margin:0 0 24px}.quick-options{display:flex;flex-direction:column;gap:12px}.quick-options>button,.quick-options>a{display:grid;grid-template-columns:1fr auto 16px;align-items:center;gap:15px;text-align:left;padding:20px 16px;background:#35565a4d;color:#F3F0E8;border:1px solid #c6aa7350;border-radius:9px}.quick-options>button:hover,.quick-options>a:hover{border-color:#C6AA73;background:#35565a80}.quick-options b{font-size:15px}.quick-options small{display:block;margin-top:6px;font-size:11px;line-height:1.5;color:#b4c9c3;font-weight:400}.quick-options strong{font-size:23px;color:#e1c58e;text-align:right}.quick-options i{font-style:normal;color:#d5bd8f}.quick-schedule{font-size:12px;line-height:1.65;color:#c2d2c8;margin:0 4px 6px}.quick-foot{font-size:12px;line-height:1.7;color:#b3c8c2;margin:23px 0 0}.quick-foot a{color:#e2c58c;text-