
.quiz-story{display:flex;align-items:flex-start;justify-content:center;min-height:calc(100svh - 76px);padding:115px 24px 55px}.quiz-deck{position:relative;z-index:3;width:min(680px,100%);padding:28px 38px 24px;background:linear-gradient(155deg,#16393eea,#071f22ec);border:1px solid #c6aa7355;border-radius:26px;box-shadow:0 25px 100px #0006;backdrop-filter:blur(18px)}.quiz-progress{display:flex;gap:7px}.quiz-progress>span{height:4px;flex:1;border-radius:4px;background:#bbd3c92b}.quiz-progress .filled{background:#ddc28c;box-shadow:0 0 16px #c6aa7344}.quiz-top{display:flex;justify-content:space-between;color:#c8b481;font-size:10px;letter-spacing:2px;margin:18px 0}.quiz-guide{display:flex;gap:14px;align-items:center;margin:22px 0}.quiz-guide>div{width:54px;height:66px;flex-shrink:0}.quiz-guide img{width:100%;height:100%;object-fit:contain}.quiz-guide p{margin:0;padding:12px 17px;background:#c6aa7310;border:1px solid #c6aa7338;border-radius:18px 18px 18px 3px;color:#deccb0;font-size:14px}.quiz-story .question{padding:0!important;margin:0;background:transparent!important;box-shadow:none;border:0!important}.quiz-story .question h1{font:500 clamp(34px,4.5vw,49px)/1.07 'Space Grotesk',Arial;letter-spacing:-1.7px;margin:18px 0 15px;color:#f1f3ed}.quiz-hint{font-size:15px;color:#b9cdc4;margin:0 0 25px}.quiz-story .choices{display:grid;grid-template-columns:1fr 1fr;gap:12px}.quiz-story .choice{position:relative;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:12px;min-height:118px;padding:20px 19px;border:1px solid #b4cec044;border-radius:15px;background:#24494e50;color:#eef2e9;text-align:left;animation:quiz-in .35s ease both}.quiz-story .choice>b{font:500 17px/1.3 'Space Grotesk',Arial;max-width:90%}.quiz-story .choice>span{font-size:24px;color:#d7bc85}.quiz-story .choice>i{font-style:normal;position:absolute;right:15px;top:15px;font-size:15px;color:#c6aa73}.quiz-story .choice.selected{border-color:#e0c488;background:#c6aa731b;box-shadow:inset 0 0 0 1px #dfc488}.quiz-story .choice:hover{border-color:#c6aa73}.quiz-story .question-actions{margin-top:25px;gap:16px}.quiz-story .question-actions>.btn{min-width:210px;justify-content:center}.quiz-foot{display:flex;flex-wrap:wrap;gap:0 20px;border-top:1px solid #b4cec026;margin-top:25px;padding-top:12px}.quiz-foot .text-btn{font-size:12px;min-height:44px;color:#c3d4c9}.quiz-privacy{font-size:11px;line-height:1.6;color:#a5bfb3;margin:8px 0 0}.quiz-story .eyebrow{font-size:10px;letter-spacing:1.5px}@keyframes quiz-in{from{opacity:.3;transform:translateY(8px)}to{opacity:1;transform:none}}.no-motion .quiz-story .choice{animation:none}@media(prefers-reduced-motion:reduce){.quiz-story .choice{animation:none}}@media(max-width:700px){.quiz-story{padding:94px 12px 28px;min-height:100svh}.quiz-deck{padding:20px 20px 16px;border-radius:20px}.quiz-guide{margin:17px 0}.quiz-guide>div{width:44px;height:54px}.quiz-guide p{font-size:13px}.quiz-story .question h1{font-size:36px;letter-spacing:-1.2px}.quiz-story .choice{min-height:110px;padding:16px 14px}.quiz-story .choice>b{font-size:16px}.quiz-story .choices{gap:10px}.quiz-story .question-actions>.btn{min-width:0;flex:1;font-size:14px}.quiz-foot{gap:0 16px}.quiz-foot .text-btn{font-size:11px}.quiz-privacy{font-size:11px}}@media(max-width:350px){.quiz-deck{padding:17px 15px}.quiz-story .question h1{font-size:31px}.quiz-story .choice>b{font-size:14px}.quiz-story .choice{min-height:104px}}

.email-plan{margin:28px 0;padding:28px;border:1px solid #c6aa7350;border-radius:18px;background:linear-gradient(130deg,#1b3c41,#0a272b)}.email-plan h2{font:500 clamp(26px,3vw,36px)/1.12 'Space Grotesk',Arial;letter-spacing:-.8px;margin:14px 0}.email-plan>p{font-size:15px;line-height:1.7;color:#bdcfc6}.email-plan form>label:first-child{display:block;font-size:14px;margin:22px 0 10px}.email-plan input[type=email]{box-sizing:border-box;width:100%;min-height:54px;background:#071f22;border:1px solid #a7c2b655;border-radius:10px;padding:14px 16px;color:#f0f3ea;font:16px Inter,Arial}.email-plan input::placeholder{color:#91aaa0}.lead-check{display:flex;gap:12px;align-items:flex-start;font-size:13px;line-height:1.6;margin:18px 0;color:#c9d8ce}.lead-check input{width:20px;height:20px;flex-shrink:0;accent-color:#c6aa73;margin-top:1px}.email-plan .lead-explainer{font-size:12px;line-height:1.7;margin-top:18px;color:#aec5b8;overflow-wrap:anywhere}.email-plan a{color:#ddc28c;text-underline-offset:4px}.lead-draft{padding:20px 0 0}.lead-draft[hidden]{display:none}.lead-draft p{font-size:14px;color:#c4d5c9;line-height:1.7}.email-plan .btn{color:#071f22}.not-ready-link{margin:25px 0;line-height:1.7}.not-ready-link a{color:#dfc38b;display:inline-block;padding:12px 0}.connect-plan{max-width:900px;margin:auto}.connect-plan>.link{display:inline-flex;min-height:44px;align-items:center}@media(max-width:700px){.email-plan{padding:24px 18px}.email-plan h2{font-size:29px}.email-plan .btn{width:100%;justify-content:center}.lead-check{font-size:13px}.summary-panel>.email-plan{margin-left:-7px;margin-right:-7px}.summary-actions{margin-top:24px}}
