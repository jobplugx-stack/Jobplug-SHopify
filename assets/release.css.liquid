.bundle-offer{border:1px solid #e3bd7888;border-radius:12px;padding:18px;margin:0 0 23px;background:linear-gradient(125deg,#e3bd7819,#ffffff02)}.bundle-heading{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:9px;letter-spacing:1px;color:var(--gold)}.bundle-heading b{background:var(--gold);color:#102426;border-radius:20px;padding:7px 10px;letter-spacing:0;font-size:11px}.bundle-choice{display:flex;gap:12px;align-items:flex-start;margin:17px 0;cursor:pointer}.bundle-choice input{width:21px;height:21px;min-height:21px;flex-shrink:0;accent-color:var(--gold)}.bundle-choice strong{display:block;font-size:16px;line-height:1.5}.bundle-choice small{display:block;color:#b9cbc1;font-size:12px;line-height:1.7;margin-top:5px}.bundle-comparison{border-top:1px solid var(--line);padding-top:13px;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:11px;color:var(--muted)}.bundle-comparison strong{font-size:14px;color:var(--gold)}.split-prep-note{padding:16px;border:1px solid var(--line);border-radius:10px;margin-bottom:20px;font-size:12px;line-height:1.8;color:#c0d0c7}.bundle-offer[hidden],.split-prep-note[hidden]{display:none}
.story-cinema{position:relative;min-height:570px;overflow:hidden;border-radius:18px;isolation:isolate;border:1px solid var(--line)}#story-scene{position:absolute;inset:0;z-index:-3}#story-scene img{width:100%;height:100%;object-fit:cover;animation:scene-in .8s ease-out}.story-overlay{position:absolute;inset:0;background:linear-gradient(90deg,#061b1ef5 0%,#061b1ec9 42%,#061b1e30 100%),linear-gradient(0deg,#061b1eaa,transparent);z-index:-2}.story-narrative{padding:56px;max-width:650px;min-height:440px}.story-narrative h3{font-size:46px;line-height:1.12;margin:24px 0;letter-spacing:-2px;max-width:480px}.story-focus{font-size:10px;color:var(--gold);letter-spacing:1.5px}.story-narrative p{font-size:16px;line-height:1.85;color:#d3dfd7;margin-top:18px;max-width:440px}.founder-guide{position:absolute;right:7%;bottom:80px;width:190px;height:240px;object-fit:contain;filter:drop-shadow(0 20px 30px #0007)}.story-controls{display:flex;align-items:center;gap:20px;padding:0 56px 35px}.story-controls button{width:48px;height:48px;border:1px solid #e3bd7870;border-radius:50%;background:#0a2426aa;color:var(--gold);font-size:20px}.story-controls button:disabled{opacity:.35;cursor:default}.story-controls span{color:var(--gold);font-size:11px;letter-spacing:3px}.story-route{display:grid;grid-template-columns:repeat(7,1fr);gap:7px;margin-top:15px}.story-route button{text-align:left;border:1px solid var(--line);border-radius:8px;background:transparent;padding:16px 10px;font-size:12px;min-height:65px}.story-route span{display:block;font-size:9px;color:var(--muted);margin-bottom:7px}.story-route button[aria-current]{border-color:var(--gold);background:#e3bd7815;color:var(--gold)}.story-foot{display:flex;justify-content:space-between;gap:20px;font-size:10px;color:var(--muted);margin-top:18px}.story-foot a{color:var(--gold)}#quick-prep{font-size:13px;padding:15px}
@media(max-width:700px){.story-cinema{min-height:615px}.story-narrative{padding:28px 23px 25px;min-height:510px}.story-narrative h3{font-size:34px;letter-spacing:-1px;margin:24px 0;max-width:280px}.story-narrative p{font-size:15px;line-height:1.8}.story-overlay{background:linear-gradient(180deg,#061b1ef0,#061b1ed0 70%,#061b1e50)}.founder-guide{width:76px;height:98px;right:18px;bottom:18px}.story-controls{padding:0 23px 25px;gap:15px}.story-route{grid-template-columns:repeat(4,1fr);gap:6px}.story-route button{font-size:10px;padding:11px 7px;min-height:58px}.story-foot{font-size:9px;line-height:1.7}.story-narrative .text-link{font-size:12px}.story-focus{font-size:9px}}
@media(max-width:700px){#journey:not(.has-location) .scene-caption{display:none}#journey:not(.has-location) .scene-copy p{max-width:180px;font-size:11px}.story-cinema{scroll-margin-top:25px}}
