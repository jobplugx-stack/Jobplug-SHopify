const founderCities=[["Wisconsin", "Where the spark began.", "lakeside", 43.8, -88.8, 0], ["San Antonio", "The first door opened.", "river", 29.4, -98.5, 1], ["Austin", "Opportunity is better shared.", "creative", 30.3, -97.7, 2], ["Houston", "A brotherhood. A foundation.", "city", 29.8, -95.4, 3], ["Denver", "New connections. A wider world.", "mountain", 39.7, -105, 5], ["New York", "Taking the vision further.", "metro", 40.7, -74, 6], ["Atlanta", "Where we are. Where we\u2019re going.", "city", 33.7, -84.4, 7]];
const founderChapters=[{"focus": "HIGH SCHOOL \u00b7 EARN AND LEISURE", "body": "The story started in high school in Wisconsin. The Earn and Leisure program was part of those early experiences. This is where the first ideas about work and opportunity began to take shape.", "highlights": ["The early spark", "Learning what was possible"]}, {"focus": "ST. MARY\u2019S UNIVERSITY", "body": "St. Mary\u2019s University helped open the door to my first internship. College in San Antonio became a turning point. That support showed me the difference one connection can make.", "highlights": ["College in San Antonio", "My first internship"]}, {"focus": "SAMSUNG AUSTIN SEMICONDUCTOR", "body": "My chapter with Samsung Austin Semiconductor became a chance to give back. I started connecting friends to opportunities and sharing what I was learning. The next door did not have to open for just one person.", "highlights": ["Giving back", "Connecting friends"]}, {"focus": "THE PUBLIC LAUNCH OF JOBPLUG", "body": "In Houston we connected with friends and built a brotherhood. That community became the foundation of JobPlug. We launched publicly and took the idea into spaces like AfroTech to keep building connections.", "highlights": ["Community into a company", "AfroTech connections"]}, {"focus": "BAE SYSTEMS", "body": "Denver brought a new chapter connected to BAE Systems. We kept building relationships and expanding the world around JobPlug. Each connection became part of the story we were taking forward.", "highlights": ["Building relationships", "Expanding our network"]}, {"focus": "BRANCHING OUT", "body": "New York was about pushing JobPlug further. We brought the vision into new conversations and kept expanding its reach. The mission stayed the same: connect people with their next opportunity.", "highlights": ["A bigger reach", "The same mission"]}, {"focus": "TEXAS ROOTS \u00b7 ATLANTA TODAY", "body": "Today we are based in Atlanta with a presence in both Texas and Atlanta. Our roots remain in Texas. Our work reaches clients across the United States. The journey keeps growing with every person we help move forward.", "highlights": ["Texas + Atlanta", "Serving clients across the US"]}];

let storyIndex=0;
function showStory(i,focusScene=false){storyIndex=i;const city=founderCities[i],chapter=founderChapters[i];$('#story-scene').innerHTML=`<img src="${window.jobplugAsset('assets/city-'+city[5]+'.jpg')}" alt="${city[0]} city scene">`;$('.story-narrative').innerHTML=`<span class="eyebrow">CHAPTER ${String(i+1).padStart(2,'0')} / ${city[0].toUpperCase()}</span><h3>${city[1]}</h3><span class="story-focus">${chapter.focus}</span><p>${chapter.body}</p>${i===6?'<a class="text-link" href="#pricing">Your next chapter starts here ↗</a>':''}`;$('#story-count').textContent=String(i+1).padStart(2,'0')+' / 07';$('#story-prev').disabled=i===0;$('#story-next').disabled=i===6;$$('[data-chapter]').forEach((b,j)=>{if(i===j)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current')});if(focusScene)$('.story-cinema').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'})}
$('.story-route').innerHTML=founderCities.map((c,i)=>`<button data-chapter="${i}"><span>${String(i+1).padStart(2,'0')}</span>${c[0]}</button>`).join('');$$('[data-chapter]').forEach(b=>b.onclick=()=>showStory(Number(b.dataset.chapter),true));$('#story-prev').onclick=()=>showStory(Math.max(0,storyIndex-1),true);$('#story-next').onclick=()=>showStory(Math.min(6,storyIndex+1),true);showStory(0);
