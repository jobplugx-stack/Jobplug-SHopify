const $=s=>document.querySelector(s);const $$=s=>[...document.querySelectorAll(s)];
const panels=[['YOUR DIRECTION','First we get to know your goals.','Choose your service. After purchase complete your Career Profile Setup. Tell us about your experience and the roles you want.',['Your experience','Your goals','Your search']],['THE WORK BEHIND THE SEARCH','We handle the application work.','We build your résumé and find roles. We submit applications on eligible weekdays. Your welcome guide and dedicated inbox keep the next steps clear.',['Find roles','Build résumé','Apply']],['YOUR NEXT CONVERSATION','Stay connected to the important stuff.','Check your Starred folder for important messages. Receive a progress report every Friday. You handle recruiter calls and interviews directly.',['Starred inbox','Friday report','Next steps']]];
function panel(n){const p=panels[n];$('.process-view').innerHTML=`<span class="eyebrow">${p[0]}</span><h3>${p[1]}</h3><p>${p[2]}</p><div class="mini-flow">${p[3].map(x=>`<span>${x}</span>`).join('')}</div>`;$$('[data-step]').forEach((x,i)=>{x.setAttribute('aria-selected',i===n);x.tabIndex=i===n?0:-1})}panel(0);$$('[data-step]').forEach((b,i)=>{b.onclick=()=>panel(i);b.onkeydown=e=>{if(['ArrowRight','ArrowDown','ArrowLeft','ArrowUp'].includes(e.key)){e.preventDefault();let n=(i+(['ArrowRight','ArrowDown'].includes(e.key)?1:2))%3;panel(n);$$('[data-step]')[n].focus()}}});
$('.menu').onclick=()=>{const open=$('nav').classList.toggle('open');$('.menu').setAttribute('aria-expanded',open)};$$('nav a').forEach(a=>a.onclick=()=>{$('nav').classList.remove('open');$('.menu').setAttribute('aria-expanded',false)});
let payment='full';let bundle=false;let separatePrep=false;
function updatePricing(){
 $$('[data-pay]').forEach(x=>x.setAttribute('aria-pressed',x.dataset.pay===payment));
 $('#bundle-offer').hidden=payment!=='full';$('#split-prep-note').hidden=payment!=='split';
 $('#bundle-choice').checked=bundle;
 $('#amount').textContent=payment==='split'?'$99':bundle?'$400':'$299';
 $('#amount-label').textContent=payment==='full'?'paid once':'to start';
 $('#payment-detail').textContent=payment==='split'?'Then $300 on counted service day 25. $399 Job Search total. A reminder is sent 2 counted service days before the charge.':bundle?'$400 total for Job Search + Interview Prep. Save $48 against the $448 separate price.':'$299 total for Job Search. Interview Prep is optional.';
 $('#quick-prep').textContent=payment==='full'?(bundle?'Remove Interview Prep from bundle':'Add prep to bundle · +$101'):(separatePrep?'Remove separate Interview Prep':'Add separate Interview Prep · $149');$('#quick-prep-note').textContent=payment==='full'?'Pay in full: $400 total for Job Search + Interview Prep.':(separatePrep?'Selected as a separate $149 purchase. Job Search still starts at $99. Combined total: $548.':'Separate $149 purchase and booking. No split-payment bundle discount.');$('#review-plan').innerHTML=(bundle&&payment==='full'?'Review my $400 bundle':'Review Job Search')+' <span>↗</span>';
}
$$('[data-pay]').forEach(b=>b.onclick=()=>{payment=b.dataset.pay;if(payment==='split')bundle=false;updatePricing()});
$('#bundle-choice').onchange=e=>{bundle=e.target.checked;updatePricing()};

function notice(title,html){$('#notice-title').textContent=title;$('#notice-body').innerHTML=html;$('#notice').showModal()}$('#review-plan').onclick=()=>{const cfg=window.JOBPLUG_CONFIG||{};const url=payment==='split'?cfg.securePlusUrl:bundle?cfg.bundleUrl:cfg.secureUrl;const summary=payment==='split'?'Job Search: $99 now + $300 on counted service Business Day 25. $399 total. A reminder is sent 2 counted service Business Days before the charge.':bundle?'Job Search + one live 45-minute Interview Prep session: $400 paid in full. Save $48 against the $448 separate price.':'Job Search: $299 paid in full.';notice('Review your next step.',`<p>${summary}</p><p>Job Search includes 30 counted service Business Days. Complete Career Profile Setup after purchase. Interview Prep is scheduled separately after purchase.</p>${payment==='split'&&separatePrep?`<p>You selected separate Interview Prep at $149. It is not included in the $99 Job Search payment. Combined cost for both services is $548.</p>${cfg.interviewPrepUrl?`<a href="${cfg.interviewPrepUrl}">Purchase Interview Prep separately · $149 ↗</a>`:''}`:''}<p><a href="/?view=policies#agreement">Read the full service agreement ↗</a> · <a href="/?view=policies#refund">Refund terms</a></p>${url?`<a class="gold wide" href="${url}">Continue to Shopify →</a><p class="fine">Your final total is shown at checkout. No payment is taken on this review screen.</p>`:'<p role="status">'+(payment==='split'?'Split-payment checkout is not open yet.':'Purchasing is not open yet.')+' Contact support@jobplug.co for help.</p>'}`)};$('#prep').onclick=()=>notice('Practice with a purpose.',`<p>Interview Prep · $149 · 45 minutes live.</p><p><strong>1. Formula.</strong> Structure clear interview answers.</p><p><strong>2. Your stories.</strong> Shape examples of your strongest projects and your growth.</p><p><strong>3. Practice.</strong> Rehearse with direct feedback.</p><p>Non-refundable once accessed. Schedule your session after purchase.</p>${window.JOBPLUG_CONFIG?.interviewPrepUrl?`<a class="gold wide" href="${window.JOBPLUG_CONFIG.interviewPrepUrl}">Buy Interview Prep · $149 →</a>`:'<p role="status">Purchasing is not open yet.</p>'}`);$$('#notice .close, .close-notice').forEach(b=>b.onclick=()=>$('#notice').close());
let step=0;const state={mode:[],location:'',area:[],stage:[]};const states='Alabama|Alaska|Arizona|Arkansas|California|Colorado|Connecticut|Delaware|District of Columbia|Florida|Georgia|Hawaii|Idaho|Illinois|Indiana|Iowa|Kansas|Kentucky|Louisiana|Maine|Maryland|Massachusetts|Michigan|Minnesota|Mississippi|Missouri|Montana|Nebraska|Nevada|New Hampshire|New Jersey|New Mexico|New York|North Carolina|North Dakota|Ohio|Oklahoma|Oregon|Pennsylvania|Rhode Island|South Carolina|South Dakota|Tennessee|Texas|Utah|Vermont|Virginia|Washington|West Virginia|Wisconsin|Wyoming'.split('|');
const choices=[['Remote','In person or hybrid'],['Office & digital','Care & community','Hands-on careers','Hospitality & service','Still exploring'],['Starting my career','Making a change','Returning to work','Building on my experience']];const headings=['Where would you like to work?','What kind of work interests you?','Where are you in your journey?'];
function tiles(list,key){return `<div class="options">${list.map((v,i)=>`<button class="option" data-value="${i}" aria-pressed="${state[key].includes(v)}"><span>${v}${key==='mode'?'<small>US-based roles</small>':''}</span><b>${state[key].includes(v)?'✓':'↗'}</b></button>`).join('')}</div>`}
function render(){$('#journey').classList.remove('revealing');paintScene(step>0);const host=$('#journey-body');$('.progress i').style.width=`${Math.min(100,(step+1)*25)}%`;if(step<3){let key=['mode','area','stage'][step];host.innerHTML=`<div class="quiz-guide"><img src="{{ 'plug-guide.png' | asset_url }}" alt=""><span>YOUR STARTING POINT · STEP ${step+1} OF 3</span></div><h2 id="journey-title" tabindex="-1">${headings[step]}</h2><p>${['Choose every work style that fits your life.','Select all that interest you. You do not have to pick just one.','Choose all that describe you. We’ll use this as your starting point.'][step]}</p>${tiles(choices[step],key)}${step===0?`<label for="location">Which state do you live in?</label><select id="location"><option value="">Choose your state</option>${states.map(x=>`<option ${state.location===x?'selected':''}>${x}</option>`).join('')}</select>`:''}<p class="error" role="status"></p><div class="quiz-actions">${step?'<button class="back">← Back</button>':''}<button class="gold next">${step===2?'See my starting point':'Continue'} <span>→</span></button></div><p class="fine">No payment to explore. Answers stay in this open page unless you choose to save them.</p>`;$$('.option').forEach(b=>b.onclick=()=>{const value=choices[step][Number(b.dataset.value)];state[key]=state[key].includes(value)?state[key].filter(v=>v!==value):[...state[key],value];if(key==='area'&&value==='Still exploring'&&state[key].includes(value))state[key]=[value];else if(key==='area'&&value!=='Still exploring')state[key]=state[key].filter(v=>v!=='Still exploring');$$('.option').forEach(x=>{const chosen=state[key].includes(choices[step][Number(x.dataset.value)]);x.setAttribute('aria-pressed',chosen);x.querySelector('b').textContent=chosen?'✓':'↗'})});if(step===0)$('#location').onchange=e=>state.location=e.target.value;$('.next').onclick=()=>{if(!state[key].length||(step===0&&!state.location)){$('.error').textContent=step===0?'Choose a work style and your state to continue.':'Choose an option to continue.';return}if(step===0){revealState();return}step++;render();$('#journey-title').focus()};if(step)$('.back').onclick=()=>{step--;render()};}else{host.innerHTML=`<div class="quiz-guide"><img src="{{ 'plug-guide.png' | asset_url }}" alt=""><span>A CLEAR PLACE TO START</span></div><h2 id="journey-title" tabindex="-1">Your next move. In focus.</h2><p>Your preferences are a starting point. JobPlug will use your full intake to guide your search.</p><div class="summary">${[['Work style',state.mode],['Location',state.location],['Career area',state.area],['Career stage',state.stage]].map(([k,v])=>`<div><small>${k}</small><strong>${Array.isArray(v)?v.join(' · '):v}</strong></div>`).join('')}</div><button class="quiet" id="edit">← Edit my answers</button><button class="gold wide" id="see-plans">View payment options <span>→</span></button><button class="outline wide" id="save" style="margin-top:12px">Save on this device</button><p class="fine" id="save-status" role="status"></p><label for="email">Want to request next steps by email? Optional.</label><input type="email" required id="email" placeholder="you@example.com" autocomplete="email"><button class="quiet" id="email-request">Prepare my email request ↗</button><p class="fine">Opens a draft to jobplux@gmail.com. You review and send it. Nothing is sent automatically.</p>`;$('#edit').onclick=()=>{step=0;render()};$('#see-plans').onclick=()=>{$('#journey').close();$('#pricing').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'})};$('#save').onclick=()=>{try{localStorage.setItem('jobplug-design-preferences',JSON.stringify(state));$('#save-status').textContent='Saved only on this browser. Use Explore my opportunity to return.'}catch{$('#save-status').textContent='This browser could not save your answers. Keep this page open.'}};$('#email-request').onclick=()=>{const input=$('#email');if(!input.value||!input.checkValidity()){input.reportValidity();input.focus();return}const body=`Hi JobPlug. I would like next steps for my search.\n\nReply email: ${input.value}\nWork style: ${state.mode.join(' · ')}\nState: ${state.location}\nCareer area: ${state.area.join(' · ')}\nCareer stage: ${state.stage.join(' · ')}\n\nRequested through JobPlug.`;location.href='mailto:jobplux@gmail.com?subject='+encodeURIComponent('My JobPlug next steps')+'&body='+encodeURIComponent(body)};}}
$$('[data-start]').forEach(b=>b.onclick=()=>{try{const saved=JSON.parse(localStorage.getItem('jobplug-design-preferences'));if(saved&&states.includes(saved.location)&&['mode','area','stage'].every((key,i)=>{const values=Array.isArray(saved[key])?saved[key]:[saved[key]];saved[key]=values;return values.length&&values.every(v=>choices[i].includes(v))})){Object.assign(state,saved);step=3}}catch{}render();$('#journey').showModal()});$('#journey .close').onclick=()=>$('#journey').close();
const heroActionObserver=new IntersectionObserver(entries=>{$('.mobile-dock').classList.toggle('resting',entries[0].isIntersecting)},{threshold:0});heroActionObserver.observe($('.hero-actions'));

function paintScene(selected){
 const scene=selected?window.JOBPLUG_STATE_SCENES[state.location]:null;
 const shell=$('#journey');shell.classList.toggle('has-location',!!scene);
 const holder=$('#journey-scene');const sceneKey=(scene?state.location:'intro')+state.mode;if(holder.dataset.scene===sceneKey)return;holder.dataset.scene=sceneKey;holder.innerHTML=`<img class="location-photo" alt="${scene?scene.city+' skyline representing '+state.location:'City skyline at sunset'}" src="${scene?scene.src:'{{ 'city-hero.png' | asset_url }}'}"><div class="scene-shade"></div><div class="scene-copy"><span class="eyebrow">${scene?'YOUR WORLD OF OPPORTUNITY':'A WORLD OF POSSIBILITY'}</span><h2>${scene?state.location:'Where will<br>you start?'}</h2><p>${scene?scene.city+' · '+(state.mode.length>1?'Open to remote and in-person or hybrid roles.':state.mode.includes('Remote')?'Your home base. Remote roles across the US.':'Your starting point for in-person or hybrid work.'):'Pick your state. Let’s find your next direction.'}</p></div><svg class="light-path" viewBox="0 0 400 500" aria-hidden="true"><path d="M50 480C20 300 340 460 270 270S60 250 190 80"/></svg><img class="scene-guide" src="{{ 'plug-guide.png' | asset_url }}" alt="Your JobPlug guide"><div class="scene-caption">${scene?'Location inspiration. Not a list of available jobs.':'Your guide. Every step of the way.'}</div>${scene?`<a class="photo-credit" href="{{ 'states--photo-attributions.txt' | asset_url }}" target="_blank" rel="noopener">${scene.city} photo credits ↗</a>`:''}`;
 const photo=holder.querySelector('.location-photo');photo.onerror=()=>{photo.onerror=null;photo.src='{{ 'city-hero.png' | asset_url }}';photo.alt='Illustrative city skyline';holder.querySelector('.photo-credit')?.remove();holder.querySelector('.scene-caption').textContent='Illustrative skyline. Location photo unavailable.'};
}
function revealState(){
 paintScene(true);$('#journey').classList.add('revealing');$('.progress i').style.width='33%';
 $('#journey-body').innerHTML=`<span class="eyebrow">YOUR FIRST CONNECTION</span><h2 id="journey-title" tabindex="-1">Hello ${state.location}.<br>Let’s open a new door.</h2><p>${state.mode.length>1?'Your home base is '+state.location+'. You’re open to remote and in-person or hybrid work. Let’s explore your direction.':state.mode.includes('Remote')?'Your home base is '+state.location+'. Your remote search can reach roles across the United States.':'Your journey starts in '+state.location+'. Next let’s explore the kind of work you want.'}</p><div class="reveal-route"><span class="route-active">Your location</span><i></i><span>Your direction</span><i></i><span>Your next step</span></div><div class="avatar-note"><img src="{{ 'plug-guide.png' | asset_url }}" alt=""><p>“You bring the ambition.<br>We’ll help with the application work.”</p></div><button class="gold wide" id="continue-scene">Find my direction <span>→</span></button><button class="quiet" id="change-state">← Explore another state</button><button class="quiet skip-pricing">Ready already? View pricing ↗</button>`;
 $('#journey-title').focus();$('#journey').scrollTop=0;
 $('#continue-scene').onclick=()=>{$('#journey').classList.remove('revealing');step=1;render();$('#journey-title').focus()};
 $('#change-state').onclick=()=>{$('#journey').classList.remove('revealing');step=0;render()};
