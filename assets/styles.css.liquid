.logo-showcase{isolation:isolate;background:radial-gradient(ellipse at 50% 40%,#16434799,transparent 65%),#06191c;padding:95px 24px}.logo-showcase h2 em{font-style:normal;color:#cfb780}.logo-showcase>p{font-size:17px}.logo-orbit{position:absolute;z-index:-1;left:calc(50% - 500px);top:100px;width:1000px;height:1000px;border:1px solid #c6aa7318;border-radius:50%;box-shadow:0 0 100px #6bafad0a,inset 0 0 100px #6bafad08;animation:logo-orbit 30s linear infinite}.logo-orbit:before{content:"";position:absolute;top:130px;left:130px;width:9px;height:9px;background:#dfc58b;border-radius:50%;box-shadow:0 0 28px #dfc58b}.brand-gallery{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));max-width:1120px;margin:48px auto 34px;gap:1px;background:linear-gradient(135deg,#c6aa7344,#98bdb713,#c6aa7344);border:1px solid #c6aa7333;border-radius:22px;overflow:hidden}.brand-stage{position:relative;isolation:isolate;display:flex;align-items:center;justify-content:center;flex-direction:column;min-height:260px;padding:36px 20px;background:#092226;overflow:hidden;transition:background .4s}.brand-stage:hover{background:#153539}.brand-stage img{width:140px;height:82px;object-fit:contain;filter:brightness(0) invert(1);opacity:.94;transition:transform .6s,opacity .6s}.brand-stage:hover img{transform:translateY(-5px) scale(1.07);opacity:1}.brand-spacex img{width:190px;height:100px;margin:-9px 0}.brand-samsung img{width:200px;height:110px;margin:-14px 0}.brand-apple img{width:66px}.brand-google img{width:72px}.brand-tesla img{width:80px}.brand-index{position:absolute;top:20px;left:22px;font:11px Arial;color:#a4bdb488;letter-spacing:2px}.brand-name{font:500 19px 'Space Grotesk',Arial,sans-serif;color:#f3f4ee;margin:20px 0 9px}.brand-caption{font:9px Arial;letter-spacing:2px;color:#bda77c}.brand-light{position:absolute;z-index:-1;inset:0;background:radial-gradient(ellipse at 50% 0%,#c9b07315,transparent 70%);opacity:.35;animation:brand-breathe 7s ease-in-out infinite;animatio