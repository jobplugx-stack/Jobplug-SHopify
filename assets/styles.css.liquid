.brand-stage{min-height:190px}.brand-name{font:500 clamp(27px,3vw,42px) 'Space Grotesk',Arial,sans-serif;letter-spacing:-1px;margin:0;color:#eef3f0}.brand-more-name{margin:0;font:500 22px 'Space Grotesk',Arial,sans-serif;color:#e0e7e3}.brand-stage:hover .brand-name{color:#fff}@media(max-width:700px){.brand-stage{min-height:145px}.brand-name{font-size:28px}.brand-more-name{font-size:20px}}

