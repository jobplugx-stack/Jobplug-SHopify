@media(max-width:600px){.story.hero.founder-story{min-height:100svh;padding:112px 6% 22px;gap:26px}.founder-stage{display:block}.founder-copy>.eyebrow{font-size:8px;letter-spacing:1.5px;gap:18px;margin-bottom:18px}.founder-story .founder-copy h1{font-size:48px;letter-spacing:-2px;margin-bottom:12px}.founder-copy h2{font-size:23px;line-height:1.2;margin-bottom:20px;max-width:92%}.founder-focus{font-size:10px;letter-spacing:1px;line-height:1.5}.founder-narrative{font-size:14px;line-height:1.75;margin-bottom:16px;max-width:100%}.founder-highlights>span{font-size:10px;padding:7px 10px}.founder-controls{margin-top:21px}.founder-controls .btn{font-size:12px;padding:13px 18px}.founder-photo-mark{display:none}.founder-story .founder-route{display:grid;grid-template-columns:repeat(3,1fr);gap:4px 6px;padding-top:14px}.founder-route button{font-size:9px;padding:4px 0;gap:5px}.founder-route button span{width:20px;height:20px;flex-shrink:0}.founder-story .scene.photographic:after{background:linear-gradient(90deg,#041c25db,#041c2577),linear-gradient(0deg,#071f22ec,transparent 70%)}.founder-story .photo{object-position:65% center}}

