<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }}{% unless page_title contains shop.name %} | {{ shop.name | escape }}{% endunless %}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% else %}<meta name="description" content="Personalized career coaching, résumé support, interview preparation, and job-search services from JobPlug.">{% endif %}<meta property="og:title" content="{{ page_title | escape }}"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:site_name" content="{{ shop.name | escape }}"><meta property="og:type" content="website">{{ content_for_header }}{{ 'jobplug.css' | asset_url | stylesheet_tag }}<script src="{{ 'jobplug.js' | asset_url }}" defer></script></head><body><a class="skip" href="#main">Skip to content</a>{% render 'jp-header' %}<main id="main" tabindex="-1">{{ content_for_layout }}</main>{% render 'jp-footer' %}</body></html>