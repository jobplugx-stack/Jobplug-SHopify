{% if template.name == 'index' and template.suffix != 'policies' %}
<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#081e20"><title>JobPlug | Done-for-you job search and Interview Prep</title><meta name="description" content="We find roles. We build your résumé. We apply for you. Explore Job Search from $299.99 and live Interview Prep from $149.99."><link rel="canonical" href="{{ canonical_url }}"><link rel="icon" href="{{ 'favicon.svg' | asset_url }}">{{ 'release.css' | asset_url | stylesheet_tag }}{{ content_for_header }}{% render 'jobplug-config' %}</head><body>{{ content_for_layout }}<script src="{{ 'state-scenes.js' | asset_url }}" defer></script><script src="{{ 'release.js' | asset_url }}" defer></script></body></html>
{% else %}
<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#071F22"><title>{{ page_title | escape }} · {{ shop.name | escape }}</title><meta name="description" content="{{ page_description | default: shop.description | escape }}"><link rel="canonical" href="{{ canonical_url }}"><link rel="icon" href="{{ 'favicon.svg' | asset_url }}">
{{ 'styles.css' | asset_url | stylesheet_tag }}
{{ 'how-story.css' | asset_url | stylesheet_tag }}
{{ 'quick-plug.css' | asset_url | stylesheet_tag }}
{{ 'mobile.css' | asset_url | stylesheet_tag }}
{{ 'plug-guide.css' | asset_url | stylesheet_tag }}
{{ 'quiz-story.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
{% render 'jobplug-config' %}</head><body><a class="skip" href="#main">Skip to content</a><header><a href="{{ routes.root_url }}#home" class="brand" aria-label="JobPlug home"><span class="brand-icon">ϟ</span> Job<b>Plug</b></a><nav id="main-navigation" aria-label="Main navigation"><a href="{{ routes.root_url }}#how">How it works</a><a href="{{ routes.root_url }}#plans">Plans</a><a href="{{ routes.root_url }}#story">Our story</a><a href="{{ routes.root_url }}#prep">Interview Prep</a><a href="{{ routes.root_url }}?view=policies#help">FAQ</a><a href="{{ routes.root_url }}?view=policies#terms">Terms</a><button class="motion motion-menu" aria-pressed="false">Pause motion</button></nav><a class="nav-cta" href="{{ routes.root_url }}#journey">Get plugged in <span>↗</span></a><button class="motion motion-header" aria-pressed="false">Pause motion</button><button aria-controls="main-navigation" class="menu" aria-label="Open navigation" aria-expanded="false">☰</button></header>{{ content_for_layout }}<footer><a class="brand" href="{{ routes.root_url }}#home">Job<b>Plug</b></a><p>A little guidance. A world of possibility.</p><div><a href="{{ routes.root_url }}?view=policies#terms">Terms & conditions</a><a href="{{ routes.root_url }}?view=policies#privacy">Privacy</a><a href="{{ routes.root_url }}?view=policies#refund">Refund & cancellation</a><a href="{{ routes.root_url }}?view=policies#help">Contact</a><a href="{{ 'photo-attributions.txt' | asset_url }}" target="_blank" rel="noopener">Photo credits ↗</a><a href="{{ 'states--photo-attributions.txt' | asset_url }}" target="_blank" rel="noopener">State photo credits ↗</a></div><small>JobPlug LLC · US clients only · Payments are handled through Shopify.</small><button class="motion" aria-pressed="false">Pause motion</button></footer><div id="announcement" class="sr-only" aria-live="polite"></div>{% if template.name == 'index' %}<script src="{{ 'privacy-policy.js' | asset_url }}" defer></script>
<script src="{{ 'state-scenes.js' | asset_url }}" defer></script>
<script src="{{ 'how-story.js' | asset_url }}" defer></script>
<script src="{{ 'app.js' | asset_url }}" defer></script>
<script src="{{ 'quick-plug.js' | asset_url }}" defer></script>
<script src="{{ 'plug-guide.js' | asset_url }}" defer></script>{% else %}<script src="{{ 'native.js' | asset_url }}" defer></script>{% endif %}</body></html>
{% endif %}