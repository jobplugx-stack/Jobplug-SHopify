<main id="main" tabindex="-1" class="content-page native-commerce"><h1>Your cart</h1>{% assign cart_approved = settings.checkout_enabled %}{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}{% unless item.product.id == settings.secure_product.id or item.product.id == settings.interview_prep_product.id %}{% assign cart_approved = false %}{% endunless %}<article><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2><p>{{ item.variant.title | escape }} · {{ item.final_line_price | money_with_currency }}</p><label for="qty-{{ forloop.index }}">Quantity</label><input id="qty-{{ forloop.index }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}"><a href="{{ item.url_to_remove }}">Remove</a></article>{% endfor %}<h2>Total {{ cart.total_price | money_with_currency }}</h2><p>Final taxes and discounts are shown at checkout.</p><button class="btn secondary" name="update" type="submit">Update cart</button>{% if cart_approved %}<button class="btn" type="submit" name="checkout">Continue to Shopify checkout</button>{% else %}<p role="status">Checkout is not open for this cart. Contact support for help.</p>{% endif %}</form>{% else %}<p>Your cart is empty.</p>{% endif %}<a href="{{ routes.root_url }}#plans">Explore packages →</a></main>
{% schema %}{"name": "Cart", "settings": []}{% endschema %}
