<main id="main" tabindex="-1" class="content-page native-commerce"><a href="{{ routes.root_url }}#plans">← Explore packages</a><h1>{{ product.title | escape }}</h1><div>{{ product.description }}</div>
{% assign approved = false %}{% if settings.checkout_enabled %}{% if product.id == settings.secure_product.id or product.id == settings.interview_prep_product.id %}{% assign approved = true %}{% endif %}{% endif %}
{% if approved and product.available %}{% form 'product', product %}<label for="variant">Choose an option</label><select id="variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money_with_currency }}{% unless variant.available %} — unavailable{% endunless %}</option>{% endfor %}</select><input type="hidden" name="quantity" value="1"><p>One-time purchase. Review your total and payment terms at Shopify checkout.</p><p><a href="{{ routes.root_url }}#agreement">Service agreement</a> · <a href="{{ routes.root_url }}#refund">Refund terms</a></p><button class="btn" type="submit">Add to cart</button>{% endform %}{% else %}<p role="status">Purchasing is not open for this product. No payment is taken here.</p><a class="btn" href="mailto:support@jobplug.co">Contact support</a>{% endif %}<p><a href="{{ routes.cart_url }}">View cart</a></p></main>
{% schema %}{"name": "Product", "settings": []}{% endschema %}
