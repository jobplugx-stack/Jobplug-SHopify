<div class="wrap page-top"><span class="eyebrow">A little guidance for the road</span><h1>{{ blog.title | default: 'Career resources' | escape }}</h1><p>Ideas and preparation for your next career move.</p></div><section class="wrap section" style="padding-top:10px">{% paginate blog.articles by 12 %}<div class="blog-grid">{% for article in blog.articles %}<article class="article-card">{% if article.image %}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy' }}{% endif %}<h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3><p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p><a class="text-link" href="{{ article.url }}">Read the article ↗</a></article>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>
{% schema %}
{
  "name": "Blog",
  "settings": [],
  "presets": [
    {
      "name": "Blog"
    }
  ]
}
{% endschema %}