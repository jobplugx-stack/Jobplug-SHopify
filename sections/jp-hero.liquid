<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><span class="pill"><span class="dot"></span> Your career. Connected.</span><h1>{{ section.settings.heading | escape }}<br><em>{{ section.settings.accent | escape }}</em></h1><p>{{ section.settings.description | escape }}</p><div class="actions"><a class="btn " href="/pages/lets-find-your-fit">Find your fit <span class="arrow" aria-hidden="true">↗</span></a><a class="text-link" href="{{ routes.collections_url }}/services">Explore our services ↗</a></div><div class="hero-note"><span>Personalized support</span><span>Across industries</span><span>Real people</span></div></div><div class="hero-art"><img class="hero-photo" src="{{ 'career-moment.jpg' | asset_url }}" alt="A professional celebrating a new opportunity" width="1500" height="1167" fetchpriority="high"><div class="art-stamp" aria-hidden="true">YOUR NEXT<br><b>↗</b>CHAPTER</div><div class="floating-note"><span class="symbol" aria-hidden="true">↗</span><div><strong>Big ambitions. A clear next step.</strong><p>Let’s connect the two.</p></div></div></div></div></section><div class="path-strip"><div class="wrap"><p>Support for every<br>stage of your career</p><span>First opportunities</span><span>Career changes</span><span>Interview confidence</span><span>Your next big move</span></div></div>
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "You bring the ambition."
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Accent headline",
      "default": "We bring the plan."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Introduction",
      "default": "From a stronger r\u00e9sum\u00e9 to a smarter job search, get the guidance and hands-on support to move toward a career that fits you."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}