<section class="lv-hero" aria-labelledby="lv-h1"><div class="lv-wrap"><span class="lv-eyebrow lv-rise" style="--i:0">Self-serve. Start today.</span><h1 id="lv-h1" class="lv-rise" style="--i:1">{{ section.settings.heading | escape }} <em>{{ section.settings.accent | escape }}</em></h1><p class="lv-lead lv-rise" style="--i:2">{{ section.settings.description | escape }}</p><div class="lv-actions lv-rise" style="--i:3"><a class="lv-btn" href="#submit">Buy Now</a><a class="lv-link" href="#build">Build it as you scroll</a></div></div></section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "The only application you will ever"
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Accent headline word",
      "default": "fill out."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Introduction",
      "default": "Scroll. Plug in each step. Submit when it is complete."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}