{% assign purchase_variant = product.selected_or_first_available_variant %}{% if product.handle == '30-day-tech-interview-vip-package-land-your-dream-job' %}{% assign purchase_variant = product.variants.first %}{% endif %}<section class="wrap section"><div class="breadcrumb"><a href="{{ routes.collections_url }}/services">Services</a> / {{ product.title | escape }}</div><div class="product-layout"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1100 | image_tag: class: 'product-image', loading: 'eager' }}{% endif %}<div class="notice">Not sure this is the right fit? <a class="text-link" href="/pages/free-consultant">Talk it through with us ↗</a></div></div><div><span class="eyebrow">Your next step, supported</span><h1>{{ product.title | escape }}</h1><div class="price" data-product-price>{{ purchase_variant.price | money }}</div>{% if product.handle == 'mock-technical-interview' %}<p class="notice">Interested in the Plug-In payment plan? Book a consultation to confirm your deposit, full balance, and payment schedule before you purchase.</p><a class="btn " href="/pages/free-consultant">Discuss payment options <span class="arrow" aria-hidden="true">↗</span></a>{% else %}{% form 'product', product, class: 'product-form' %}<label for="variant-{{ section.id }}">Service option</label><select id="variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}{% unless product.handle == '30-day-tech-interview-vip-package-land-your-dream-job' and variant.title == 'Deposit' %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if variant == purchase_variant %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Unavailable{% endunless %}</option>{% endunless %}{% endfor %}</select><input name="quantity" type="hidden" value="1"><button type="submit" class="btn" {% unless purchase_variant.available %}disabled{% endunless %}>{% if purchase_variant.available %}Add to cart →{% else %}Currently unavailable{% endif %}</button>{% endform %}{% endif %}<div class="prose product-description">{% if product.handle == '30-day-tech-interview-vip-package-land-your-dream-job' %}<h2>Focused support for your job search</h2><p>Get hands-on application support, an industry-tailored mock interview, curated job alerts, and VIP event access.</p><h3>The 30-day interview commitment</h3><p>If no interview is secured within 30 days, JobPlug offers a free career strategy session. Confirm eligibility and the start date during onboarding.</p><h3>Payment</h3><p>The pay-in-full option is shown above. To discuss the Plug-In Plan and its payment schedule, book a consultation.</p>{% elsif product.handle == 'mock-technical-interview' %}<h2>Flexible ways to get started</h2><p>The Plug-In Plan offers application support, interview preparation, profile setup, curated opportunities, and ongoing communication. Confirm all payment terms with JobPlug before enrolling.</p>{% else %}{{ product.description }}{% endif %}</div></div></div></section>
{% schema %}
{
  "name": "Product",
  "settings": [],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}