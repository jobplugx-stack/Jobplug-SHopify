{% assign purchase_variant = product.selected_or_first_available_variant %}{% if product.handle == '30-day-tech-interview-vip-package-land-your-dream-job' %}{% assign purchase_variant = product.variants.first %}{% endif %}<section class="wrap section"><div class="breadcrumb"><a href="{{ routes.collections_url }}/services">Services</a> / {{ product.title | escape }}</div><div class="product-layout"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1100 | image_tag: class: 'product-image', loading: 'eager' }}{% endif %}<div class="notice">Questions? Email <a class="text-link" href="mailto:jobplugx@gmail.com">jobplugx@gmail.com</a></div></div><div><span class="eyebrow">Your next step, supported</span><h1>{{ product.title | escape }}</h1><div class="price" data-product-price>{{ purchase_variant.price | money }}</div>{% if product.handle == 'mock-technical-interview' %}<p class="notice">This deposit option is retired. For two payments choose Secure Plus.</p><a class="btn " href="/products/{{ settings.handle_secure_plus }}">See Secure Plus <span class="arrow" aria-hidden="true">↗</span></a>{% else %}{% form 'product', product, class: 'product-form' %}<label for="variant-{{ section.id }}">Service option</label><select id="variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}{% unless product.handle == '30-day-tech-interview-vip-package-land-your-dream-job' and variant.title == 'Deposit' %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if variant == purchase_variant %}selected{% endif %}>{{ variant.title | escape }} | {{ variant.price | money }}{% unless variant.available %} | Unavailable{% endunless %}</option>{% endunless %}{% endfor %}</select><input name="quantity" type="hidden" value="1"><button type="submit" name="checkout" class="btn" {% unless purchase_variant.available %}disabled{% endunless %}>{% if purchase_variant.available %}Buy Now{% else %}Currently unavailable{% endif %}</button>{% endform %}{% endif %}<div class="prose product-description">{% if product.handle == '30-day-tech-interview-vip-package-land-your-dream-job' or product.handle == 'mock-technical-interview' %}<h2>Legacy product</h2><p>This product is being replaced. For current plans choose Secure or Secure Plus. {% comment %}[CONFIRM] Owner decides to archive this legacy product.{% endcomment %}</p>{% else %}{{ product.description }}{% endif %}</div></div></div></section>
{% schema %}
{
  "name": "Product",
  "settings": [],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}