<section class="wrap section"><h1>Find your next step.</h1><form action="{{ routes.search_url }}" class="contact-form"><div class="field"><label for="site-search">Search services and resources</label><input id="site-search" type="search" name="q" value="{{ search.terms | escape }}"></div><button class="btn">Search</button></form>{% if search.performed %}<p>{{ search.results_count }} results</p>{% paginate search.results by 20 %}<div class="service-grid">{% for item in search.results %}<article class="service-card"><h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3></article>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</section>
{% schema %}
{
  "name": "Search",
  "settings": [],
  "presets": [
    {
      "name": "Search"
    }
  ]
}
{% endschema %}