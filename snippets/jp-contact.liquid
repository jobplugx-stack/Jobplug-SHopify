<section class="wrap section"><span class="eyebrow">We’re here to help</span><h1>Let’s connect.</h1><p style="margin-top:20px">Questions about a service or your next step? Send JobPlug a message.</p>{% form 'contact', class: 'contact-form' %}{% if form.posted_successfully? %}<p class="notice" role="status">Thanks for reaching out. Your message has been sent to JobPlug.</p>{% endif %}{{ form.errors | default_errors }}<div class="field"><label for="contact-name">Your name</label><input id="contact-name" name="contact[name]" autocomplete="name" required></div><div class="field"><label for="contact-email">Email address</label><input id="contact-email" name="contact[email]" type="email" autocomplete="email" required></div><div class="field"><label for="contact-body">How can we help?</label><textarea id="contact-body" name="contact[body]" rows="6" required></textarea></div><button class="btn" type="submit">Send message ↗</button>{% endform %}</section>